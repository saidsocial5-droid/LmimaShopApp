<Application x:Class="LmimaShopV2.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LmimaShopV2.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LmimaShopV2.Desktop;component/Themes/Common.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LmimaShopV2.Desktop;component/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:MoneyConverter x:Key="Money" />
            <conv:DateTimeConverter x:Key="DateTime" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
