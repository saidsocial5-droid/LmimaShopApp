<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LmimaShop V2 - تسجيل الدخول"
        Width="440"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock Text="LmimaShop"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="نظام نقطة البيع"
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource ErrorText}"
                           Margin="0,12,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                <Button Content="تسجيل الدخول"
                        Style="{StaticResource AccentButton}"
                        Margin="0,16,0,0"
                        MinHeight="42"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <Button Content="إعداد قاعدة البيانات"
                        Style="{StaticResource SubtleButton}"
                        Margin="0,8,0,0"
                        Command="{Binding ConfigureDatabaseCommand}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="الحساب الافتراضي: admin / admin123"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" />

        <Button Grid.Row="3"
                Content="خروج"
                Style="{StaticResource SubtleButton}"
                Margin="0,16,0,0"
                Command="{Binding CancelCommand}" />
    </Grid>
</Window>
