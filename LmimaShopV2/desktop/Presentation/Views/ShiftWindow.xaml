<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.ShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الوردية"
        Width="1000"
        Height="660"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="الوردية" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding OpenShiftText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="فتح وردية" Style="{StaticResource SectionTitle}"
                                   Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding OpeningFloat, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="فتح الوردية"
                                Style="{StaticResource SuccessButton}"
                                Margin="0,10,0,0"
                                Command="{Binding OpenCommand}"
                                Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <Separator Margin="0,16,0,12"
                                   Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="إغلاق الوردية" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="المتوقع نقدًا" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding ExpectedCashText}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="المبلغ المعدود" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     TextWrapping="Wrap" />

                            <Button Content="إغلاق الوردية"
                                    Style="{StaticResource DangerButton}"
                                    Margin="0,10,0,0"
                                    Command="{Binding CloseCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource ErrorText}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="سجل الورديات" Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1"
                            Content="تحديث"
                            Style="{StaticResource SubtleButton}"
                            Command="{Binding RefreshCommand}" />
                    <Button Grid.Column="2"
                            Content="إغلاق"
                            Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0"
                            Click="OnCloseClick" />
                </Grid>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource AppDataGrid}"
                          ItemsSource="{Binding RecentShifts}"
                          SelectedItem="{Binding SelectedShift}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="*" />
                        <DataGridTextColumn Header="الفتح"
                                            Binding="{Binding OpenedAt, Converter={StaticResource DateTime}, ConverterParameter=dd/MM/yyyy HH:mm}"
                                            Width="160" />
                        <DataGridTextColumn Header="الإغلاق"
                                            Binding="{Binding ClosedAt, Converter={StaticResource DateTime}, ConverterParameter=dd/MM/yyyy HH:mm}"
                                            Width="160" />
                        <DataGridTextColumn Header="المبيعات النقدية"
                                            Binding="{Binding CashSales, Converter={StaticResource Money}}"
                                            Width="140" />
                        <DataGridTextColumn Header="المتوقع"
                                            Binding="{Binding ExpectedCash, Converter={StaticResource Money}}"
                                            Width="130" />
                        <DataGridTextColumn Header="المعدود"
                                            Binding="{Binding CountedCash, Converter={StaticResource Money}}"
                                            Width="130" />
                        <DataGridTextColumn Header="الفرق"
                                            Binding="{Binding Difference, Converter={StaticResource Money}}"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorder}"
                        Margin="0,12,0,0"
                        MaxHeight="260"
                        Visibility="{Binding ZReport, Converter={StaticResource NullToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="تقرير الوردية (Z)" Style="{StaticResource SectionTitle}" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عدد العمليات" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding ZReport.SalesCount}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="إجمالي المبيعات" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding ZReport.TotalRevenue, Converter={StaticResource Money}}"
                                           Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TVA" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding ZReport.TvaCollected, Converter={StaticResource Money}}"
                                           Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Grid>
                        <Button DockPanel.Dock="Bottom"
                                Content="طباعة التقرير"
                                Style="{StaticResource AppButton}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Command="{Binding PrintReportCommand}" />
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedText}">
                                    <Run Text="نقدًا: " />
                                    <Run Text="{Binding ZReport.CashSales, Mode=OneWay, Converter={StaticResource Money}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                    <Run Text="بطاقة: " />
                                    <Run Text="{Binding ZReport.CardSales, Mode=OneWay, Converter={StaticResource Money}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                    <Run Text="آجل: " />
                                    <Run Text="{Binding ZReport.CreditSales, Mode=OneWay, Converter={StaticResource Money}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                    <Run Text="تحصيل ديون: " />
                                    <Run Text="{Binding ZReport.DebtPaymentsCash, Mode=OneWay, Converter={StaticResource Money}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                    <Run Text="إرجاعات: " />
                                    <Run Text="{Binding ZReport.ReturnsRefund, Mode=OneWay, Converter={StaticResource Money}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                    <Run Text="الرصيد الافتتاحي: " />
                                    <Run Text="{Binding ZReport.OpeningFloat, Mode=OneWay, Converter={StaticResource Money}}" />
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
