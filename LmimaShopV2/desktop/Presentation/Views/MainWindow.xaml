<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LmimaShop V2 - نقطة البيع"
        Width="1360"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Navigation sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,10">
                    <TextBlock Text="{Binding ShopName}"
                               Margin="18,0,0,0"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBlock Text="نظام نقطة البيع"
                               Margin="18,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarMutedBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Separator Background="{DynamicResource SidebarMutedBrush}" Margin="14,0,14,10" />
                    <TextBlock Text="{Binding UserName}"
                               Margin="18,0,0,0"
                               Foreground="{DynamicResource SidebarTextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UserRole}"
                               Margin="18,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarMutedBrush}" />
                    <Button Content="تسجيل الخروج"
                            Style="{StaticResource NavButton}"
                            Margin="8,12,8,0"
                            Command="{Binding LogoutCommand}" />
                    <Button Content="خروج من التطبيق"
                            Style="{StaticResource NavButton}"
                            Margin="8,4,8,0"
                            Click="OnExitClick" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="البيع"
                                   Margin="18,4,0,6"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarMutedBrush}" />
                        <Button Content="الوردية"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenShiftCommand}" />
                        <Button Content="الإرجاع"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenReturnsCommand}" />

                        <TextBlock Text="البيانات"
                                   Margin="18,12,0,6"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarMutedBrush}" />
                        <Button Content="المنتجات"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenProductsCommand}" />
                        <Button Content="العملاء"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenCustomersCommand}" />
                        <Button Content="الموردون"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenSuppliersCommand}" />

                        <TextBlock Text="الإدارة"
                                   Margin="18,12,0,6"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarMutedBrush}" />
                        <Button Content="التقارير"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenReportsCommand}"
                                Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="الإعدادات"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenSettingsCommand}"
                                Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="المستخدمون"
                                Style="{StaticResource NavButton}"
                                Command="{Binding OpenUsersCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Product catalogue + cart -->
        <Grid Grid.Column="1" Margin="16,14,8,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ShopName}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding ShiftStatus}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄" Style="{StaticResource IconButton}"
                            ToolTip="تحديث"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="🌓" Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            ToolTip="تبديل المظهر"
                            Command="{Binding ToggleThemeCommand}" />
                    <Button Content="🔗" Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            ToolTip="اقتران الهاتف"
                            Command="{Binding GeneratePairingCommand}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"
                         ToolTip="ابحث عن منتج أو امسح رمزًا شريطيًا" />
                <Button Grid.Column="1"
                        Content="بحث"
                        Style="{StaticResource AppButton}"
                        Margin="6,0,0,0"
                        Command="{Binding SearchProductsCommand}" />
                <ComboBox Grid.Column="2"
                          Margin="6,0,0,0"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategory}"
                          ToolTip="تصفية حسب الصنف" />
                <Button Grid.Column="3"
                        Content="كل الأصناف"
                        Style="{StaticResource SubtleButton}"
                        Margin="6,0,0,0"
                        Command="{Binding ClearFiltersCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="176"
                                    MinHeight="112"
                                    Margin="0,0,10,10"
                                    Style="{StaticResource AppButton}"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.AddProductCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Barcode}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SellPrice, Converter={StaticResource Money}}"
                                               Margin="0,8,0,0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
                                        <Run Text="المخزون:" />
                                        <Run Text="{Binding StockQuantity, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Style="{StaticResource CardBorder}"
                    Padding="10"
                    Margin="0,10,0,0"
                    Visibility="{Binding PairingCode, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding PairingQr}" Width="96" Height="96" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="امسح الرمز من هاتفك" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="رمز الاقتران: " />
                            <Run Text="{Binding PairingCode, Mode=OneWay}" FontWeight="Bold" FontSize="18" />
                        </TextBlock>
                        <TextBlock Text="{Binding PairingUrl}" Style="{StaticResource MutedText}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}">
                            <Run Text="ينتهي في " />
                            <Run Text="{Binding PairingExpires, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="نسخ الرابط"
                                Style="{StaticResource SubtleButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding CopyPairingLinkCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cart -->
        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="سلة البيع" Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1"
                            Content="إفراغ"
                            Style="{StaticResource SubtleButton}"
                            Command="{Binding ClearCartCommand}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,4,0,10">
                    <TextBlock Text="العميل" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Customers}"
                              DisplayMemberPath="FullName"
                              SelectedItem="{Binding SelectedCustomer}"
                              IsEditable="True"
                              ToolTip="اختر عميلًا للبيع الآجل أو نقاط الولاء" />
                    <Button Content="بيع بدون عميل"
                            Style="{StaticResource SubtleButton}"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearCustomerCommand}" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Content="✕"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <StackPanel Grid.Row="1" Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Margin="0,6,0,0">
                                            <Button Content="−"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Width="62"
                                                     Margin="6,0,6,0"
                                                     TextAlignment="Center"
                                                     Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="+"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Unit}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DisplayTotal}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,4,0,0">
                                                <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:0.00}}" />
                                                <Run Text=" × " />
                                                <Run Text="{Binding Qty, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="خصم إجمالي %"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding OverallDiscountPct, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Separator Margin="0,10,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="المجموع الفرعي" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="الخصم" Style="{StaticResource StatLabel}" Margin="0,6,0,0" />
                            <TextBlock Text="TVA" Style="{StaticResource StatLabel}" Margin="0,6,0,0" />
                            <TextBlock Text="الإجمالي" Style="{StaticResource StatLabel}" Margin="0,8,0,0" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Subtotal, Converter={StaticResource Money}}"
                                       HorizontalAlignment="Left" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DiscountAmount, Converter={StaticResource Money}}"
                                       HorizontalAlignment="Left" Margin="0,6,0,0" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TvaAmount, Converter={StaticResource Money}}"
                                       HorizontalAlignment="Left" Margin="0,6,0,0" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Total, Converter={StaticResource Money}}"
                                       HorizontalAlignment="Left" Margin="0,8,0,0"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="إتمام البيع"
                            Style="{StaticResource SuccessButton}"
                            Margin="0,14,0,0"
                            MinHeight="48"
                            FontSize="16"
                            Command="{Binding CheckoutCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource ErrorText}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
