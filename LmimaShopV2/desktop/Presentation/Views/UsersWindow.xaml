<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المستخدمون"
        Width="980"
        Height="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="المستخدمون" Style="{StaticResource PageTitle}" />
                <TextBlock Text="إدارة الحسابات والصلاحيات."
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      Style="{StaticResource AppDataGrid}"
                      Margin="0,12,0,0"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="120" />
                    <DataGridTextColumn Header="مفعّل" Binding="{Binding IsActive}" Width="80" />
                    <DataGridTextColumn Header="آخر تحديث"
                                        Binding="{Binding UpdatedAt, Converter={StaticResource DateTime}, ConverterParameter=dd/MM/yyyy}"
                                        Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="مستخدم جديد" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="الاسم الكامل" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="NewUserPassword" PasswordChanged="OnNewUserPasswordChanged" />

                    <TextBlock Text="الدور" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding Roles}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedRole}" />

                    <Button Content="إنشاء المستخدم"
                            Style="{StaticResource AccentButton}"
                            Margin="0,12,0,0"
                            Command="{Binding CreateCommand}" />

                    <Separator Margin="0,16,0,12" />

                    <TextBlock Text="إعادة تعيين كلمة المرور" Style="{StaticResource SectionTitle}" />
                    <PasswordBox x:Name="ResetPassword" PasswordChanged="OnResetPasswordChanged" />
                    <Button Content="تغيير كلمة المرور"
                            Style="{StaticResource AppButton}"
                            Margin="0,10,0,0"
                            Command="{Binding ResetPasswordCommand}" />
                    <Button Content="تفعيل / تعطيل"
                            Style="{StaticResource SubtleButton}"
                            Margin="0,8,0,0"
                            Command="{Binding ToggleActiveCommand}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource ErrorText}"
                               Margin="0,14,0,0"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="إغلاق"
                            Style="{StaticResource SubtleButton}"
                            Margin="0,16,0,0"
                            Click="OnCloseClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
