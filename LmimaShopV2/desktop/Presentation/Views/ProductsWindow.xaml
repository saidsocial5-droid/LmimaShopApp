<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المنتجات"
        Width="1120"
        Height="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="المنتجات" Style="{StaticResource PageTitle}" />
                <TextBlock Text="المخزون، الأسعار والأصناف."
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" />
                <ComboBox Grid.Column="1"
                          Margin="6,0,0,0"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding FilterCategory}" />
                <Button Grid.Column="2"
                        Content="بحث"
                        Style="{StaticResource AppButton}"
                        Margin="6,0,0,0"
                        Command="{Binding SearchCommand}" />
                <Button Grid.Column="3"
                        Content="منتج جديد"
                        Style="{StaticResource AccentButton}"
                        Margin="6,0,0,0"
                        Command="{Binding NewProductCommand}" />
            </Grid>

            <DataGrid Grid.Row="2"
                      Style="{StaticResource AppDataGrid}"
                      Margin="0,12,0,0"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="140" />
                    <DataGridTextColumn Header="الصنف" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="الشراء"
                                        Binding="{Binding CostPrice, Converter={StaticResource Money}}"
                                        Width="110" />
                    <DataGridTextColumn Header="البيع"
                                        Binding="{Binding SellPrice, Converter={StaticResource Money}}"
                                        Width="110" />
                    <DataGridTextColumn Header="المخزون" Binding="{Binding StockQuantity}" Width="90" />
                    <DataGridTextColumn Header="TVA %" Binding="{Binding TvaRate}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="الباركود" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding EditCategory}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="سعر الشراء" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="سعر البيع" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SellPrice, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="المخزون" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="نسبة TVA" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TvaRate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="مسار الصورة" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="منتج بالوزن (كغ)"
                                  IsChecked="{Binding IsWeighed}"
                                  Margin="0,12,0,0" />

                        <Separator Margin="0,14,0,10" />

                        <TextBlock Text="صنف جديد" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="إضافة"
                                    Style="{StaticResource AppButton}"
                                    Margin="6,0,0,0"
                                    Command="{Binding AddCategoryCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource ErrorText}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Content="حفظ"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanManage}" />
                    <Button Content="حذف"
                            Style="{StaticResource DangerButton}"
                            Margin="8,0,0,0"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanManage}" />
                    <Button Content="إغلاق"
                            Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
