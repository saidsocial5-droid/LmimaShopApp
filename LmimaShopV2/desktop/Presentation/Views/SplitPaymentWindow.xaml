<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.SplitPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الدفع"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Border Style="{StaticResource CardBorder}" Margin="18">
        <StackPanel>
            <TextBlock Text="إتمام الدفع" Style="{StaticResource PageTitle}" />

            <Border Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding CustomerText}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding CreditText}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="المجموع" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource MoneyText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock Text="الباقي" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding ChangeText}" Style="{StaticResource MoneyText}" />
                </StackPanel>
            </Grid>

            <Separator Margin="0,12,0,8" />

            <TextBlock Text="نقدًا" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Cash, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}" />

            <TextBlock Text="بطاقة" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Card, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}" />

            <TextBlock Text="آجل" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Credit, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}" />

            <Button Content="ادفع المتبقي آجلًا"
                    Style="{StaticResource SubtleButton}"
                    Margin="0,10,0,0"
                    Command="{Binding PayRemainingOnCreditCommand}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="المتبقي" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding RemainingText}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       Margin="0,10,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,0">
                <Button Content="تأكيد"
                        Style="{StaticResource SuccessButton}"
                        MinWidth="110"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="إلغاء"
                        Style="{StaticResource SubtleButton}"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
