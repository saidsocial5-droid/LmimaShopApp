<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.CustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="العملاء"
        Width="1200"
        Height="740"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="العملاء" Style="{StaticResource PageTitle}" />
                <TextBlock Text="الأرصدة الآجلة، نقاط الولاء وكشوف الحساب."
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1"
                        Content="بحث"
                        Style="{StaticResource AppButton}"
                        Margin="6,0,0,0"
                        Command="{Binding SearchCommand}" />
                <Button Grid.Column="2"
                        Content="عميل جديد"
                        Style="{StaticResource AccentButton}"
                        Margin="6,0,0,0"
                        Command="{Binding NewCustomerCommand}" />
            </Grid>

            <DataGrid Grid.Row="2"
                      Style="{StaticResource AppDataGrid}"
                      Margin="0,12,0,0"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140" />
                    <DataGridTextColumn Header="حد الائتمان"
                                        Binding="{Binding CreditLimit, Converter={StaticResource Money}}"
                                        Width="130" />
                    <DataGridTextColumn Header="الدين"
                                        Binding="{Binding DueBalance, Converter={StaticResource Money}}"
                                        Width="120" />
                    <DataGridTextColumn Header="النقاط" Binding="{Binding LoyaltyPoints}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3"
                    Style="{StaticResource CardBorder}"
                    Margin="0,12,0,0"
                    MaxHeight="260"
                    Visibility="{Binding IsStatementVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding StatementTitle}"
                               Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Style="{StaticResource MutedText}">
                        <Run Text="الرصيد الافتتاحي: " />
                        <Run Text="{Binding OpeningBalance, Mode=OneWay, Converter={StaticResource Money}}" />
                    </TextBlock>
                    <DataGrid Style="{StaticResource AppDataGrid}"
                              ItemsSource="{Binding StatementEntries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ"
                                                Binding="{Binding Date, Converter={StaticResource DateTime}, ConverterParameter=dd/MM/yyyy HH:mm}"
                                                Width="150" />
                            <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="110" />
                            <DataGridTextColumn Header="المرجع" Binding="{Binding Ref}" Width="*" />
                            <DataGridTextColumn Header="مدين"
                                                Binding="{Binding Debit, Converter={StaticResource Money}}"
                                                Width="110" />
                            <DataGridTextColumn Header="دائن"
                                                Binding="{Binding Credit, Converter={StaticResource Money}}"
                                                Width="110" />
                            <DataGridTextColumn Header="الرصيد"
                                                Binding="{Binding Balance, Converter={StaticResource Money}}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="الاسم الكامل" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="الهاتف" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="العنوان" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="حد الائتمان" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 TextWrapping="Wrap" />

                        <Separator Margin="0,14,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الدين الحالي" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding SelectedDueText}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="نقاط الولاء" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding SelectedLoyalty}"
                                           FontSize="17"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,14,0,10" />

                        <TextBlock Text="تسجيل دفعة" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="المبلغ" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="طريقة الدفع" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPaymentMethod}" />

                        <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="تسجيل الدفعة"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding AddPaymentCommand}" />
                            <Button Content="كشف الحساب"
                                    Style="{StaticResource SubtleButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ShowStatementCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource ErrorText}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Content="حفظ" Style="{StaticResource AccentButton}" Command="{Binding SaveCustomerCommand}" />
                    <Button Content="حذف"
                            Style="{StaticResource DangerButton}"
                            Margin="8,0,0,0"
                            Command="{Binding DeleteCustomerCommand}" />
                    <Button Content="إغلاق"
                            Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
