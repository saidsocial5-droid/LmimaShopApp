<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.SuppliersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الموردون"
        Width="1000"
        Height="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="الموردون" Style="{StaticResource PageTitle}" />
                <TextBlock Text="جهات التوريد وبيانات الاتصال."
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1"
                        Content="بحث"
                        Style="{StaticResource AppButton}"
                        Margin="6,0,0,0"
                        Command="{Binding SearchCommand}" />
                <Button Grid.Column="2"
                        Content="مورد جديد"
                        Style="{StaticResource AccentButton}"
                        Margin="6,0,0,0"
                        Command="{Binding NewSupplierCommand}" />
            </Grid>

            <DataGrid Grid.Row="2"
                      Style="{StaticResource AppDataGrid}"
                      Margin="0,12,0,0"
                      ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="160" />
                    <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*" />
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="الهاتف" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="العنوان" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="80"
                             TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource ErrorText}"
                               Margin="0,12,0,0"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Content="حفظ" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
                    <Button Content="حذف"
                            Style="{StaticResource DangerButton}"
                            Margin="8,0,0,0"
                            Command="{Binding DeleteCommand}" />
                    <Button Content="إغلاق"
                            Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
