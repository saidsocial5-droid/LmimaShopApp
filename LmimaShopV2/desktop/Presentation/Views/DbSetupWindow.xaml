<Window x:Class="LmimaShopV2.Desktop.Presentation.Views.DbSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد قاعدة البيانات"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Border Style="{StaticResource CardBorder}" Margin="18">
        <StackPanel>
            <TextBlock Text="إعداد قاعدة البيانات" Style="{StaticResource PageTitle}" />
            <TextBlock Text="الاتصال يُخزَّن مشفّرًا على هذا الجهاز فقط (DPAPI)."
                       Style="{StaticResource MutedText}"
                       Margin="0,4,0,16" />

            <TextBlock Text="الخادم" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="المنفذ" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="المستخدم" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />

            <TextBlock Text="اسم قاعدة البيانات" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource ErrorText}"
                       Margin="0,14,0,0"
                       Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,0">
                <Button Content="اختبار الاتصال"
                        Style="{StaticResource AppButton}"
                        Command="{Binding TestCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Content="حفظ"
                        Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Content="إلغاء"
                        Style="{StaticResource SubtleButton}"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
