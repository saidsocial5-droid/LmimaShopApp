<Window x:Class="LmimaShopApp.SyncConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مراجعة تعارضات المزامنة" Height="450" Width="800" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="سجل التعارضات بين أجهزة الهاتف والحاسوب:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <DataGrid x:Name="ConflictsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الوقت" Binding="{Binding created_at}" Width="120"/>
                <DataGridTextColumn Header="الجهاز" Binding="{Binding device_id}" Width="100"/>
                <DataGridTextColumn Header="النوع" Binding="{Binding entity_type}" Width="100"/>
                <DataGridTextColumn Header="نسخة الحاسوب" Binding="{Binding server_data}" Width="*"/>
                <DataGridTextColumn Header="نسخة الهاتف" Binding="{Binding client_data}" Width="*"/>
                <DataGridTemplateColumn Header="إجراءات" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="اعتماد الحاسوب" Tag="{Binding id}" Click="BtnKeepServer_Click" Margin="2" Padding="5,2" Background="#FFF1F1F1"/>
                                <Button Content="اعتماد الهاتف" Tag="{Binding id}" Click="BtnKeepClient_Click" Margin="2" Padding="5,2" Background="#FFD5E8D4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="تحديث" Click="BtnRefresh_Click" Margin="5" Padding="15,5"/>
            <Button Content="إغلاق" Click="BtnClose_Click" Margin="5" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>
