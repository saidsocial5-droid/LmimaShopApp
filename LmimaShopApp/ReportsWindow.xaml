<UserControl x:Class="LmimaShopApp.ReportsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LmimaShopApp"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="#F5F6FA"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <ResourceDictionary>

            <!-- 2. استايلات خاصة بالتقارير -->
            <Style x:Key="ReportMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#BDC3C7"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActiveReportMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3498DB"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استايل الكروت الإحصائية -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.04"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استايل الجداول داخل التقارير -->
            <Style x:Key="NormalTableStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
                <Setter Property="RowHeight" Value="38"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#2C3E50"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="Foreground" Value="#4B5563"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF5FB"/>
                                    <Setter Property="Foreground" Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- أ. المساحة الرئيسية للتقرير واللوحة -->
                <ColumnDefinition Width="*"/>
                <!-- ب. قائمة التقارير الفرعية (Sub-Sidebar) -->
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- ب. قائمة التقارير الفرعية (Sub-Sidebar) -->
            <Border Grid.Column="1" Background="#2C3E50" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- هيدر العنوان -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📊 التقارير" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- خيارات التقارير -->
                    <StackPanel Grid.Row="1" Margin="10,10,10,0">
                        <Button x:Name="btnMenuDashboard" Content="🏠  لوحة التحكم" Style="{StaticResource ActiveReportMenuButtonStyle}" Click="BtnMenuDashboard_Click"/>
                        <Button x:Name="btnMenuSales" Content="💰  تقارير المبيعات" Style="{StaticResource ReportMenuButtonStyle}" Click="BtnMenuSales_Click"/>
                        <Button x:Name="btnMenuPayments" Content="💳  طرق الدفع" Style="{StaticResource ReportMenuButtonStyle}" Click="BtnMenuPayments_Click"/>
                        <Button x:Name="btnMenuReturns" Content="🔄  المرتجعات" Style="{StaticResource ReportMenuButtonStyle}" Click="BtnMenuReturns_Click"/>
                        <Button x:Name="btnMenuCustomers" Content="👥  الزبناء والديون" Style="{StaticResource ReportMenuButtonStyle}" Click="BtnMenuCustomers_Click"/>
                        <Button x:Name="btnMenuCashier" Content="👤  الكاشير" Style="{StaticResource ReportMenuButtonStyle}" Click="BtnMenuCashier_Click"/>
                        <Button x:Name="btnMenuInventory" Content="📦  المخزون" Style="{StaticResource ReportMenuButtonStyle}" Click="BtnMenuInventory_Click"/>
                    </StackPanel>

                    <!-- أزرار الإجراءات في الأسفل -->
                    <StackPanel Grid.Row="2" Margin="10" Orientation="Vertical">
                        <!-- زر إقفال اليوم -->
                        <Button Content="⭐ إقفال اليوم" Background="#E67E22" Foreground="White" BorderThickness="0" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnCloseDay_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- زر تصفير التقارير للصفر -->
                        <Button Content="🗑️ تصفير التقارير للصفر" Background="#C0392B" Foreground="White" BorderThickness="0" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnResetReports_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- أ. لوحة التحكم والبيانات والإحصائيات -->
            <Grid x:Name="gridDashboard" Grid.Column="0" Margin="10" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- 1. شريط الفلترة العلوي -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. كروت الأرقام الرئيسية -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. الرسومات البيانية (الرسوم) -->
                    <RowDefinition Height="*"/>
                    <!-- 4. الجداول الفرعية بالأسفل -->
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- 1. شريط الفلترة العلوي -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- العنوان -->
                        <TextBlock Text="لوحة التحكم والتحليلات اليومية" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <!-- الفلاتر في الوسط -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- فلتر التواريخ -->
                            <Button Content="اليوم" x:Name="btnDay" Width="55" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Margin="2,0" FontWeight="Bold" Click="BtnDateFilter_Click"/>
                            <Button Content="أمس" x:Name="btnYesterday" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnDateFilter_Click"/>
                            <Button Content="الأسبوع" x:Name="btnWeek" Width="55" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnDateFilter_Click"/>
                            <Button Content="الشهر" x:Name="btnMonth" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnDateFilter_Click"/>

                            <DatePicker x:Name="dpFrom" Width="110" Height="30" Margin="8,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="2,0"/>
                            <DatePicker x:Name="dpTo" Width="110" Height="30" Margin="3,0,5,0" VerticalAlignment="Center"/>

                            <Button Content="🔄" Width="30" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnRefreshData_Click" ToolTip="تحديث البيانات"/>
                        </StackPanel>

                        <!-- فلاتر الدفع والكاشير -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="cmbCashier" Width="100" Height="30" Margin="3,0" VerticalContentAlignment="Center" SelectionChanged="CmbFilter_SelectionChanged">
                                <ComboBoxItem Content="كل الكاشير" IsSelected="True"/>
                            </ComboBox>
                            <ComboBox x:Name="cmbPayMethod" Width="100" Height="30" Margin="3,0" VerticalContentAlignment="Center" SelectionChanged="CmbFilter_SelectionChanged">
                                <ComboBoxItem Content="كل طرق الدفع" IsSelected="True"/>
                                <ComboBoxItem Content="كاش"/>
                                <ComboBoxItem Content="بطاقة"/>
                                <ComboBoxItem Content="أجل"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. كروت الأرقام الرئيسية -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                    <!-- كارت 1: إجمالي المبيعات -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي المبيعات" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTotalSales" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,2"/>
                                <TextBlock x:Name="txtCashSales" Text="النقد (كاش): 0.00" FontSize="11" Foreground="#27AE60"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- كارت 2: عدد الفواتير -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عدد الفواتير" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtInvoiceCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,4,0,2"/>
                                <TextBlock x:Name="txtCardSales" Text="البطاقة: 0.00" FontSize="11" Foreground="#2980B9"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EAEDED" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- كارت 3: الأصناف المباعة -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الأصناف المباعة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTotalItemsSold" Text="0" FontSize="20" FontWeight="Bold" Foreground="#E67E22" Margin="0,4,0,2"/>
                                <TextBlock x:Name="txtCreditSales" Text="الأجل: 0.00" FontSize="11" Foreground="#7F8C8D"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FEF5E7" VerticalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- كارت 4: المرتجعات -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المرتجعات" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTotalReturns" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#C0392B" Margin="0,4,0,2"/>
                                <TextBlock x:Name="txtSplitSales" Text="مقسم: 0.00" FontSize="11" Foreground="#8E44AD"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FDEDEC" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 3. الرسومات البيانية -->
                <Grid Grid.Row="2" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <!-- أ. رسم بياني دائري (يمين في RTL) -->
                        <ColumnDefinition Width="380"/>
                        <!-- ب. رسم خطي اتجاه المبيعات (يسار في RTL) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- أ. المبيعات حسب الفئة (Donut/Pie Chart) -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📊 المبيعات حسب الفئة" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- منطقة الرسم -->
                                <Canvas x:Name="donutCanvas" Grid.Column="1" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- الليجند -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="donutLegend" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ب. اتجاه المبيعات (Line Chart) -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📈 اتجاه المبيعات" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1">
                                <Canvas x:Name="lineChartCanvas" Margin="30,10,20,30" Background="#FAFAFA"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. الجداول الفرعية بالأسفل -->
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- أفضل 5 منتجات -->
                        <ColumnDefinition Width="2*"/>
                        <!-- أفضل كاشير -->
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- أفضل 5 منتجات -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="👑 أفضل 5 منتجات مبيعاً" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgTopProducts" Grid.Row="1" Style="{StaticResource NormalTableStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="100"/>
                                    <DataGridTextColumn Header="الإيراد (درهم)" Binding="{Binding Revenue, StringFormat={}{0:N2}}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- أفضل كاشير -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="👑 أفضل كاشير" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="50" Height="50" CornerRadius="25" Background="#EBF5FB" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="lblTopCashierName" Text="مدير النظام" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblTopCashierSales" Text="1,644.50 درهم" FontSize="14" FontWeight="Bold" Foreground="#27AE60" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ت. تقرير الزبناء والديون -->
            <Grid x:Name="gridCustomers" Grid.Column="0" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- 1. شريط الفلترة والتحكم العلوي -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. كروت الأرقام الرئيسية للديون -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. المحتوى الرئيسي: جدول التفاصيل وإحصائيات أكثر المدينين -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. شريط الفلترة والتحكم العلوي -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- العنوان -->
                        <TextBlock Text="تقرير الزبناء والتحليلات الائتمانية والديون" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <!-- شريط البحث الفوري -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="بحث عن زبون:" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,8,0" FontSize="13"/>
                            <TextBox x:Name="txtCustomersReportSearch" Width="220" Height="30" VerticalContentAlignment="Center" Padding="5,2" TextChanged="TxtCustomersReportSearch_TextChanged" Margin="0,0,10,0"/>
                            <Button Content="تحديث" Width="70" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnRefreshCustomersReport_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. كروت الأرقام الرئيسية للديون -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                    <!-- كارت 1: إجمالي الديون المستحقة -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي الديون المستحقة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTotalDebts" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#C0392B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FDEDEC" VerticalAlignment="Center">
                                <TextBlock Text="💳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- كارت 2: عدد الزبناء المدينين -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الزبناء المدينون" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtDebtorCustomers" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EAEDED" VerticalAlignment="Center">
                                <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- كارت 3: إجمالي سقف الائتمان -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي سقف الائتمان" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTotalCreditLimit" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- كارت 4: أعلى دين فردي -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="أعلى مدين" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTopDebtor" Text="-" FontSize="14" FontWeight="Bold" Foreground="#D35400" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FEF5E7" VerticalAlignment="Center">
                                <TextBlock Text="👑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 3. المحتوى الرئيسي: جدول التفاصيل وإحصائيات أكثر المدينين -->
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- أعلى 5 مدينين بيانياً -->
                        <ColumnDefinition Width="380"/>
                        <!-- جدول الزبناء والديون -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- جدول تفاصيل الديون والزبناء -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📋 قائمة تفاصيل حسابات الزبناء الائتمانية والديون" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgCustomersReport" Grid.Row="1" Style="{StaticResource NormalTableStyle}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الزبون" Binding="{Binding FullName, Mode=OneWay}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="يسمح بالأجل؟" Binding="{Binding AllowCreditStr, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="حد الائتمان (د.م.)" Binding="{Binding CreditLimit, StringFormat={}{0:N2}, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="الدين الحالي (د.م.)" Binding="{Binding DueBalance, StringFormat={}{0:N2}, Mode=OneWay}" Width="125">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="تاريخ آخر كريدي" Binding="{Binding LastCreditDateStr, Mode=OneWay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- أكثر 5 عملاء استهلاكاً وسحباً للديون -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📈 أعلى 5 عملاء مديونية استهلاكاً للائتمان" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <ListBox x:Name="lstTopDebtors" Grid.Row="1" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6" Width="330">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FullName}" FontWeight="Bold" FontSize="12" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CreditUsageText}" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Left"/>
                                            </Grid>
                                            <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="{Binding CreditUsagePercent, Mode=OneWay}" Foreground="#E67E22" Background="#EAEDED"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 1. تقارير وفواتير المبيعات -->
            <Grid x:Name="gridSales" Grid.Column="0" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- 1. شريط الفلترة العلوي -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. كروت الأرقام الرئيسية -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. المحتوى الرئيسي: جدول الفواتير ومعاينة تفاصيل الفاتورة -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. شريط الفلترة والتحكم العلوي -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="📋 سجل فواتير المبيعات والمبيعات اليومية" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="اليوم" Width="55" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Margin="2,0" FontWeight="Bold" Click="BtnSalesDateFilter_Click" Tag="today"/>
                            <Button Content="أمس" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnSalesDateFilter_Click" Tag="yesterday"/>
                            <Button Content="الأسبوع" Width="55" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnSalesDateFilter_Click" Tag="week"/>
                            <Button Content="الشهر" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnSalesDateFilter_Click" Tag="month"/>

                            <DatePicker x:Name="dpSalesFrom" Width="110" Height="30" Margin="8,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="2,0"/>
                            <DatePicker x:Name="dpSalesTo" Width="110" Height="30" Margin="3,0,5,0" VerticalAlignment="Center"/>

                            <Button Content="🔄" Width="30" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnRefreshSales_Click" ToolTip="تحديث الفواتير"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtSalesSearch" Width="180" Height="30" VerticalContentAlignment="Center" Padding="5,2" TextChanged="TxtSalesSearch_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. كروت الأرقام الرئيسية للمبيعات -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي المبيعات" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtSalesTotalSales" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#E8F8F5" VerticalAlignment="Center">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عدد الفواتير" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtSalesInvoiceCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="متوسط قيمة الفاتورة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtSalesAvgInvoice" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#8E44AD" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#F4ECF7" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي القطع المباعة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtSalesItemsSold" Text="0" FontSize="18" FontWeight="Bold" Foreground="#D35400" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FEF5E7" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 3. المحتوى: جدول الفواتير يميناً + معاينة بنود الفاتورة يساراً -->
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- تفاصيل الفاتورة المحددة -->
                        <ColumnDefinition Width="380"/>
                        <!-- جدول الفواتير -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- جدول الفواتير -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📋 قائمة الفواتير الصادرة" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgSalesReport" Grid.Row="1" Style="{StaticResource NormalTableStyle}" IsReadOnly="True" SelectionChanged="DgSalesReport_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceId, Mode=OneWay}" Width="85"/>
                                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding DateStr, Mode=OneWay}" Width="135"/>
                                    <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierOnly, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="المجموع (د.م.)" Binding="{Binding TotalAmount, StringFormat={}{0:N2}, Mode=OneWay}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- لوحة تفاصيل الفاتورة المحددة -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="🔍 محتويات وسلع الفاتورة" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblSelectedInvoiceHeader" Grid.Row="1" Text="حدد فاتورة من الجدول لعرض بنودها" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgInvoiceDetailsItems" Grid.Row="2" Style="{StaticResource NormalTableStyle}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="السلعة / المنتج" Binding="{Binding ProductName, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityStr, Mode=OneWay}" Width="65"/>
                                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPriceStr, Mode=OneWay}" Width="65"/>
                                    <DataGridTextColumn Header="المجموع" Binding="{Binding SubTotalStr, Mode=OneWay}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button x:Name="btnPrintSelectedInvoice" Grid.Row="3" Content="🖨️ طباعة وصل هذه الفاتورة" Height="36" Margin="0,8,0,0" Background="#3498DB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnPrintSelectedInvoice_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. تقرير طرق الدفع -->
            <Grid x:Name="gridPayments" Grid.Column="0" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط الفلترة -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💳 تقرير وتحليلات طرق الدفع والتحصيل المالي" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="اليوم" Width="55" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Margin="2,0" FontWeight="Bold" Click="BtnPaymentsDateFilter_Click" Tag="today"/>
                            <Button Content="أمس" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnPaymentsDateFilter_Click" Tag="yesterday"/>
                            <Button Content="الأسبوع" Width="55" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnPaymentsDateFilter_Click" Tag="week"/>
                            <Button Content="الشهر" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnPaymentsDateFilter_Click" Tag="month"/>

                            <DatePicker x:Name="dpPaymentsFrom" Width="110" Height="30" Margin="8,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="2,0"/>
                            <DatePicker x:Name="dpPaymentsTo" Width="110" Height="30" Margin="3,0,5,0" VerticalAlignment="Center"/>

                            <Button Content="🔄" Width="30" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnRefreshPayments_Click" ToolTip="تحديث البيانات"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- كروت الإجماليات -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المدفوع نقداً (كاش)" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtPaymentsCashTotal" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtPaymentsCashCount" Text="0 عملية" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#E8F8F5" VerticalAlignment="Center">
                                <TextBlock Text="💵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="مبيعات الكريدي (الأجل)" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtPaymentsCreditTotal" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#E67E22" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtPaymentsCreditCount" Text="0 عملية" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FEF5E7" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="البطاقة البنكية" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtPaymentsCardTotal" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtPaymentsCardCount" Text="0 عملية" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="💳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الإجمالي العام للتحصيل" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtPaymentsGrandTotal" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtPaymentsTotalTransactions" Text="0 عملية" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EAEDED" VerticalAlignment="Center">
                                <TextBlock Text="💼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- المحتوى: التوزيع البياني يساراً والجدول التفصيلي يميناً -->
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- تفاصيل الجدول اليومي لطرق الدفع -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📅 التوزيع اليومي للمبيعات حسب طريقة الدفع" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgPaymentBreakdown" Grid.Row="1" Style="{StaticResource NormalTableStyle}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateStr, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="مبيعات الكاش (د.م.)" Binding="{Binding CashSales, StringFormat={}{0:N2}, Mode=OneWay}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="فواتير الكاش" Binding="{Binding CashCount, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="مبيعات الكريدي (د.م.)" Binding="{Binding CreditSales, StringFormat={}{0:N2}, Mode=OneWay}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E67E22"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="فواتير الكريدي" Binding="{Binding CreditCount, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="مجموع اليوم (د.م.)" Binding="{Binding TotalSales, StringFormat={}{0:N2}, Mode=OneWay}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- نسب المساهمة المئوية -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📊 نسبة مساهمة كل طريقة دفع" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- كاش -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="💵 النقد (كاش)" FontWeight="Bold" FontSize="12" Foreground="#27AE60" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblPaymentCashPercent" Text="0.0%" FontWeight="Bold" FontSize="12" Foreground="#27AE60" HorizontalAlignment="Left" Grid.Column="1"/>
                                </Grid>
                                <ProgressBar x:Name="pbPaymentCash" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#27AE60" Background="#EAEDED" Margin="0,0,0,18"/>

                                <!-- كريدي -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📝 الكريدي (الأجل)" FontWeight="Bold" FontSize="12" Foreground="#E67E22" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblPaymentCreditPercent" Text="0.0%" FontWeight="Bold" FontSize="12" Foreground="#E67E22" HorizontalAlignment="Left" Grid.Column="1"/>
                                </Grid>
                                <ProgressBar x:Name="pbPaymentCredit" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#E67E22" Background="#EAEDED" Margin="0,0,0,18"/>

                                <!-- بطاقة -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="💳 البطاقة البنكية" FontWeight="Bold" FontSize="12" Foreground="#2980B9" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblPaymentCardPercent" Text="0.0%" FontWeight="Bold" FontSize="12" Foreground="#2980B9" HorizontalAlignment="Left" Grid.Column="1"/>
                                </Grid>
                                <ProgressBar x:Name="pbPaymentCard" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#2980B9" Background="#EAEDED"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. تقرير المرتجعات والإلغاءات -->
            <Grid x:Name="gridReturns" Grid.Column="0" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط الفلترة والإجراءات -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔄 سجل المرتجعات والإلغاءات والسلع المستردة" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="اليوم" Width="55" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Margin="2,0" FontWeight="Bold" Click="BtnReturnsDateFilter_Click" Tag="today"/>
                            <Button Content="أمس" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnReturnsDateFilter_Click" Tag="yesterday"/>
                            <Button Content="الأسبوع" Width="55" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnReturnsDateFilter_Click" Tag="week"/>
                            <Button Content="الشهر" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnReturnsDateFilter_Click" Tag="month"/>

                            <DatePicker x:Name="dpReturnsFrom" Width="110" Height="30" Margin="8,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="2,0"/>
                            <DatePicker x:Name="dpReturnsTo" Width="110" Height="30" Margin="3,0,5,0" VerticalAlignment="Center"/>

                            <Button Content="🔄" Width="30" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnRefreshReturns_Click" ToolTip="تحديث المرتجعات"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="➕ تسجيل مرتجع جديد" Height="32" Padding="12,0" Background="#C0392B" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnOpenAddReturnOverlay_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- كروت الإجماليات -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,5">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي المبالغ المسترجعة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtReturnsTotalAmount" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#C0392B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FDEDEC" VerticalAlignment="Center">
                                <TextBlock Text="💸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عدد عمليات الإرجاع" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtReturnsCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي السلع المسترجعة للمخزن" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtReturnsTotalQty" Text="0" FontSize="18" FontWeight="Bold" Foreground="#8E44AD" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#F4ECF7" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- جدول المرتجعات -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋 قائمة عمليات الإرجاع المسجلة" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <DataGrid x:Name="dgReturnsReport" Grid.Row="1" Style="{StaticResource NormalTableStyle}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id, Mode=OneWay}" Width="50"/>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding ReturnDateStr, Mode=OneWay}" Width="135"/>
                                <DataGridTextColumn Header="رقم الفاتورة الأصلية" Binding="{Binding InvoiceRefStr, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="المنتج المسترجع" Binding="{Binding ProductName, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityStr, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="المبلغ المسترجع (د.م.)" Binding="{Binding RefundAmount, StringFormat={}{0:N2}, Mode=OneWay}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="سبب الإرجاع" Binding="{Binding Reason, Mode=OneWay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. تقرير أداء الكاشير -->
            <Grid x:Name="gridCashier" Grid.Column="0" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط الفلترة -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="👤 تقرير أداء ومبيعات الكاشير والموظفين" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="اليوم" Width="55" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Margin="2,0" FontWeight="Bold" Click="BtnCashierDateFilter_Click" Tag="today"/>
                            <Button Content="أمس" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnCashierDateFilter_Click" Tag="yesterday"/>
                            <Button Content="الأسبوع" Width="55" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnCashierDateFilter_Click" Tag="week"/>
                            <Button Content="الشهر" Width="50" Height="30" Background="White" Foreground="#5D6D7E" BorderBrush="#BDC3C7" BorderThickness="1" Margin="2,0" Click="BtnCashierDateFilter_Click" Tag="month"/>

                            <DatePicker x:Name="dpCashierFrom" Width="110" Height="30" Margin="8,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="2,0"/>
                            <DatePicker x:Name="dpCashierTo" Width="110" Height="30" Margin="3,0,5,0" VerticalAlignment="Center"/>

                            <Button Content="🔄" Width="30" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnRefreshCashier_Click" ToolTip="تحديث البيانات"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- كروت الإجماليات -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="أعلى كاشير مبيعاً" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtTopCashierNameCard" Text="-" FontSize="16" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtTopCashierAmountCard" Text="0.00 د.م." FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#E8F8F5" VerticalAlignment="Center">
                                <TextBlock Text="🏆" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي الفواتير الصادرة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtCashierTotalInvoices" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="متوسط السلة العامة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtCashierOverallAvgBasket" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#8E44AD" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#F4ECF7" VerticalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الكاشيرات النشطة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtActiveCashiersCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EAEDED" VerticalAlignment="Center">
                                <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- جدول أداء الكاشير -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋 قائمة تقييم ومبيعات الموظفين والكاشير" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <DataGrid x:Name="dgCashierReport" Grid.Row="1" Style="{StaticResource NormalTableStyle}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموظف / الكاشير" Binding="{Binding CashierName, Mode=OneWay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="إجمالي المبيعات (د.م.)" Binding="{Binding TotalSales, StringFormat={}{0:N2}, Mode=OneWay}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="متوسط الفاتورة (د.م.)" Binding="{Binding AvgInvoice, StringFormat={}{0:N2}, Mode=OneWay}" Width="140"/>
                                <DataGridTextColumn Header="نسبة المساهمة" Binding="{Binding SalesShareStr, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="آخر عملية بيع" Binding="{Binding LastSaleDateStr, Mode=OneWay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. تقرير المخزون -->
            <Grid x:Name="gridInventory" Grid.Column="0" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط البحث والفلترة -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📦 تقرير المخزون والتقييم المالي الشامل" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Grid.Column="2" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="بحث:" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtInventorySearch" Width="180" Height="30" VerticalContentAlignment="Center" Padding="5,2" TextChanged="TxtInventorySearch_TextChanged" Margin="0,0,10,0"/>

                            <TextBlock Text="الفئة:" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,5,0"/>
                            <ComboBox x:Name="cmbInventoryCategory" Width="120" Height="30" Margin="0,0,10,0" SelectionChanged="CmbInventoryFilter_SelectionChanged">
                                <ComboBoxItem Content="كل الفئات" IsSelected="True"/>
                            </ComboBox>

                            <TextBlock Text="الحالة:" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,5,0"/>
                            <ComboBox x:Name="cmbInventoryStatus" Width="110" Height="30" Margin="0,0,10,0" SelectionChanged="CmbInventoryFilter_SelectionChanged">
                                <ComboBoxItem Content="كل الحالات" IsSelected="True"/>
                                <ComboBoxItem Content="متوفر فقط"/>
                                <ComboBoxItem Content="منخفض فقط (أقل من 5)"/>
                                <ComboBoxItem Content="نافد تماماً (0)"/>
                            </ComboBox>

                            <Button Content="🔄" Width="30" Height="30" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnRefreshInventory_Click" ToolTip="تحديث المخزون"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- كروت الإجماليات المالية للمخزون -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="قيمة المخزون (سعر البيع)" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtInventoryRetailValue" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#E8F8F5" VerticalAlignment="Center">
                                <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="قيمة المخزون (سعر الشراء)" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtInventoryCostValue" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#2980B9" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EBF5FB" VerticalAlignment="Center">
                                <TextBlock Text="💼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="هامش الربح المتوقع" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtInventoryExpectedProfit" Text="0.00 د.م." FontSize="18" FontWeight="Bold" Foreground="#8E44AD" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#F4ECF7" VerticalAlignment="Center">
                                <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سلع منخفضة أو نافدة" FontSize="12" Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtInventoryLowStockCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#C0392B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FDEDEC" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- جدول المخزون -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋 قائمة تقييم وجرد السلع في المخزن" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                        <DataGrid x:Name="dgInventoryReport" Grid.Row="1" Style="{StaticResource NormalTableStyle}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName, Mode=OneWay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding Category, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="المخزون" Binding="{Binding StockQuantityStr, Mode=OneWay}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="سعر الشراء (د.م.)" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="سعر البيع (د.م.)" Binding="{Binding SellPrice, StringFormat={}{0:N2}, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="إجمالي القيمة البيعية" Binding="{Binding TotalRetailValue, StringFormat={}{0:N2}, Mode=OneWay}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الربح المتوقع" Binding="{Binding ExpectedProfit, StringFormat={}{0:N2}, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="حالة السلعة" Binding="{Binding StatusStr, Mode=OneWay}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- نافذة تسجيل مرتجع جديد منبثقة -->
        <Grid x:Name="returnsOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Width="450" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🔄 تسجيل عملية إرجاع / استرداد" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="رقم الفاتورة الأصلية (اختياري):" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtReturnInvoiceId" Height="34" FontSize="13" Padding="6,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="اسم المنتج المسترجع:" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtReturnProductName" Height="34" FontSize="13" Padding="6,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الكمية المسترجعة:" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtReturnQuantity" Text="1" Height="34" FontSize="13" Padding="6,2" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="المبلغ المسترد (د.م.):" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtReturnRefundAmount" Text="0.00" Height="34" FontSize="13" Padding="6,2" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <TextBlock Text="سبب الإرجاع:" FontSize="12" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbReturnReason" Height="34" FontSize="13">
                            <ComboBoxItem Content="سلعة تالفة أو بها عيب" IsSelected="True"/>
                            <ComboBoxItem Content="تراجع الزبون عن الشراء"/>
                            <ComboBoxItem Content="خطأ في تسجيل الصنف"/>
                            <ComboBoxItem Content="انتهاء تاريخ الصلاحية"/>
                            <ComboBoxItem Content="أخرى"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="تأكيد وحفظ الإرجاع" Width="140" Height="38" Background="#C0392B" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnConfirmReturn_Click" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="إلغاء" Width="90" Height="38" Background="#7F8C8D" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCancelReturn_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
