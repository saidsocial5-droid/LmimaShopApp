                                    </Border>
                                    <TextBlock Text="100 درهم" FontSize="13.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 50 درهم -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="50" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="46" Height="28" CornerRadius="4" BorderBrush="#6EE7B7" BorderThickness="1.5" Margin="0,0,10,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_50.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="50 درهم" FontSize="13.5" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 20 درهم -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="20" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="46" Height="28" CornerRadius="4" BorderBrush="#C4B5FD" BorderThickness="1.5" Margin="0,0,10,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_20.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="20 درهم" FontSize="13.5" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- الصف الثاني: القطع النقدية (10 دراهم، 5 دراهم، درهمان، درهم واحد، نصف درهم) -->
                        <UniformGrid Columns="5" Margin="0,0,0,6">
                            <!-- 10 دراهم -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="10" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#F59E0B" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_10.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="10 دراهم" FontSize="13.5" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 5 دراهم -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="5" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#94A3B8" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_5.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="5 دراهم" FontSize="13.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2 دراهم (درهمان) -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="2" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#D97706" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_2.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="2 دراهم" FontSize="13.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 1 درهم (درهم واحد) -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="1" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#64748B" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_1.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="1 درهم" FontSize="13.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 0.5 درهم (50 فرنك) -->
                            <Button Style="{StaticResource CashButtonStyle}" Tag="0.5" Click="BtnQuickCash_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#64748B" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_05.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="0.5 درهم (50 فرنك)" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- الصف الثالث: المبلغ المطلوب بالضبط (تماماً) وزر مسح المبلغ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- المبلغ بالضبط -->
                            <Button Grid.Column="0" Style="{StaticResource CashButtonStyle}" Tag="exact" Click="BtnQuickCash_Click" Height="48" Background="#F0FDF4" BorderBrush="#86EFAC">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" BorderBrush="#34D399" BorderThickness="1.5" Margin="0,0,10,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/Cash/cash_exact.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="المبلغ المطلوب بالضبط (تماماً)" FontSize="14" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- مسح وتصفير المبلغ -->
                            <Button Grid.Column="1" Style="{StaticResource CashButtonStyle}" Tag="clear" Click="BtnQuickCash_Click" Height="48" Width="120" Margin="8,2,2,2" Background="#FEF2F2" BorderBrush="#FECACA">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔄 مسح (0)" FontSize="14" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- أزرار الإنهاء والإلغاء -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="btnConfirmCheckout" Content="تأكيد وطباعة الفاتورة" Style="{StaticResource KeypadButtonStyle}" Width="210" Height="46" Background="#27AE60" Foreground="White" BorderThickness="0" Click="BtnConfirmCheckout_Click" Margin="0,0,12,0" FontSize="15" FontWeight="Bold"/>
                        <Button Content="🔓 فتح الدرج" Style="{StaticResource KeypadButtonStyle}" Width="140" Height="46" Background="#3498DB" Foreground="White" BorderThickness="0" Click="BtnOpenDrawer_Click" Margin="0,0,12,0" FontSize="15" FontWeight="Bold"/>
                        <Button Content="إلغاء" Style="{StaticResource KeypadButtonStyle}" Width="110" Height="46" Background="#7F8C8D" Foreground="White" BorderThickness="0" Click="BtnCancelCheckout_Click" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- نافذة إضافة منتج يدوي المنبثقة -->
        <Grid x:Name="manualItemOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Width="500" Height="360" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- عنوان الشاشة -->
                        <RowDefinition Height="*"/>    <!-- المدخلات ولوحة الأرقام -->
                        <RowDefinition Height="Auto"/> <!-- أزرار التحكم -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="➕ إضافة منتج يدوي" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <!-- المدخلات (اليمين) -->
                            <ColumnDefinition Width="Auto"/> <!-- لوحة الأرقام (اليسار) -->
                        </Grid.ColumnDefinitions>

                        <!-- المدخلات -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="اسم المنتج:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtManualItemName" Grid.Column="0" Text="" Style="{StaticResource ModalTextBoxStyle}" TextAlignment="Right" GotFocus="OverlayTextBox_GotFocus"/>
                                <Button Content="⌨️" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Width="35" Height="34" Click="BtnToggleVirtualKeyboard_Click" Focusable="False" Margin="5,0,0,0" ToolTip="إظهار/إخفاء لوحة المفاتيح"/>
                            </Grid>

                            <TextBlock Text="السعر الفردي (درهم):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                            <TextBox x:Name="txtManualItemPrice" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,10" TextAlignment="Right" GotFocus="OverlayTextBox_GotFocus"/>

                            <Grid Height="34" Margin="0,0,0,10">
                                <Grid.Resources>
                                    <Style x:Key="QtyButtonStyle" TargetType="Button">
                                        <Setter Property="Background" Value="#F2F3F4"/>
                                        <Setter Property="Foreground" Value="#2C3E50"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E5E8E8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#D5D8D8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.ColumnSpan="3" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Background="White"/>

                                <!-- Button plus (visual right in RTL) -->
                                <Button Content="+" Grid.Column="0" Style="{StaticResource QtyButtonStyle}" Click="BtnQtyPlus_Click"/>

                                <!-- Separator 1 -->
                                <Border Grid.Column="0" Width="1" Background="#BDC3C7" HorizontalAlignment="Left"/>

                                <!-- Quantity TextBox (visual middle) -->
                                <TextBox x:Name="txtManualItemQty" Grid.Column="1" Text="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="14" GotFocus="OverlayTextBox_GotFocus"/>

                                <!-- Separator 2 -->
                                <Border Grid.Column="2" Width="1" Background="#BDC3C7" HorizontalAlignment="Right"/>

                                <!-- Button minus (visual left in RTL) -->
                                <Button Content="-" Grid.Column="2" Style="{StaticResource QtyButtonStyle}" Click="BtnQtyMinus_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- لوحة أرقام جانبية صغيرة -->
                        <Grid Grid.Column="1" Width="180" Height="220" Margin="20,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Content="C" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="⌫" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Background="#34495E" Foreground="White" BorderThickness="0" Margin="2" FontSize="14" FontWeight="Bold"/>
                            
                            <Button Content="1" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="2" Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="3" Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            
                            <Button Content="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="5" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="6" Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            
                            <Button Content="7" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="8" Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="9" Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            
                            <Button Content="," Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                            <Button Content="0" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="OverlayKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="إضافة للسلة" Style="{StaticResource KeypadButtonStyle}" Width="120" Height="36" Background="#27AE60" Foreground="White" BorderThickness="0" Click="BtnConfirmAddManualItem_Click" Margin="0,0,10,0"/>
                        <Button Content="إلغاء" Style="{StaticResource KeypadButtonStyle}" Width="90" Height="36" Background="#7F8C8D" Foreground="White" BorderThickness="0" Click="BtnCancelAddManualItem_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="receiptPreviewOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Width="380" Height="580" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- عنوان الشاشة -->
                        <RowDefinition Height="*"/>    <!-- منطقة معاينة الفاتورة -->
                        <RowDefinition Height="Auto"/> <!-- أزرار التحكم -->
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="📄 معاينة الفاتورة قبل الطباعة" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    
                    <!-- ورقة الفاتورة المصغرة داخل ScrollViewer -->
                    <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" Background="#F8F9F9" Padding="15" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border x:Name="borderReceiptPreview" Background="White" Padding="15" Width="290" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#BDC3C7"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Image x:Name="imgPreviewLogo" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" Stretch="Uniform"/>
                                    <TextBlock x:Name="lblPreviewStoreName" Text="اسم المتجر" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5" TextAlignment="Center"/>
                                <TextBlock x:Name="lblPreviewStoreDetails" Text="العنوان والهاتف" FontSize="10" Foreground="#566573" HorizontalAlignment="Center" Margin="0,0,0,10" TextAlignment="Center"/>
                                
                                <TextBlock Text="------------------------------------------" FontSize="10" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                                
                                <TextBlock x:Name="lblPreviewInvoiceMeta" Text="تفاصيل الفاتورة" FontSize="10" HorizontalAlignment="Right" LineHeight="15" TextAlignment="Right"/>
                                
                                <TextBlock Text="==========================" FontSize="10" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,5"/>
                                
                                <!-- جدول المواد -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="المنتج" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="الكمية" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="المجموع" FontWeight="Bold" FontSize="10" HorizontalAlignment="Left"/>
                                </Grid>
                                
                                <TextBlock Text="------------------------------------------" FontSize="10" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                                
                                <!-- قائمة البنود المضافة ديناميكياً -->
                                <ItemsControl x:Name="itemsReceiptPreview">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProductName}" FontSize="9.5" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:0.###}}" FontSize="9.5" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:N2}}" FontSize="9.5" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock Text="==========================" FontSize="10" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,5"/>
                                
                                <!-- المجاميع -->
                                <Grid Margin="0,2">
                                    <TextBlock Text="الإجمالي:" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblPreviewTotalAmount" Text="0.00 درهم" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="المدفوع:" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblPreviewPaidAmount" Text="0.00 درهم" FontSize="10" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="المتبقي للزبون:" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="lblPreviewChangeDue" Text="0.00 درهم" FontSize="10" HorizontalAlignment="Left"/>
                                </Grid>
                                
                                <TextBlock Text="------------------------------------------" FontSize="10" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,5"/>
                                
                                <TextBlock x:Name="lblPreviewInvoiceFooter" Text="شكراً لزيارتكم" FontSize="10.5" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- أزرار الإجراءات -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="🖨️ طباعة الفاتورة" Style="{StaticResource KeypadButtonStyle}" Width="150" Height="40" Background="#27AE60" Foreground="White" BorderThickness="0" Click="BtnPrintPreviewInvoice_Click" Margin="0,0,10,0"/>
                        <Button Content="❌ إغلاق بدون طباعة" Style="{StaticResource KeypadButtonStyle}" Width="150" Height="40" Background="#E74C3C" Foreground="White" BorderThickness="0" Click="BtnClosePreviewInvoice_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
            </Grid>

            <!-- ب. محتوى باقي الشاشات -->
            <ContentControl x:Name="mainContentControl" Visibility="Collapsed"/>
        </Grid>

        <!-- لوحة مفاتيح الحروف المدمجة -->
        <Border x:Name="virtualKeyboardPanel" Grid.Column="0" Grid.ColumnSpan="2" Height="260" MaxWidth="1350" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#2C3E50" BorderBrush="#34495E" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Visibility="Collapsed" Panel.ZIndex="9999" Padding="10,7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="90" RenderingBias="Quality" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Row 0: letters row 1 -->
                <UniformGrid x:Name="keyboardRow0" Grid.Row="0" Columns="12" Margin="0,2"/>
                <!-- Row 1: letters row 2 -->
                <UniformGrid x:Name="keyboardRow1" Grid.Row="1" Columns="12" Margin="0,2"/>
                <!-- Row 2: letters row 3 -->
                <UniformGrid x:Name="keyboardRow2" Grid.Row="2" Columns="12" Margin="0,2"/>
                
                <!-- Row 3: Space, Backspace, Language Switch, Size, Hide -->
                <Grid Grid.Row="3" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Switch Lang -->
                        <ColumnDefinition Width="*"/>    <!-- Space -->
                        <ColumnDefinition Width="Auto"/> <!-- Backspace -->
                        <ColumnDefinition Width="Auto"/> <!-- Size Mode Toggle -->
                        <ColumnDefinition Width="Auto"/> <!-- Hide -->
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnSwitchLang" Grid.Column="0" Content="عربي / Français" Style="{StaticResource KeypadButtonStyle}" Width="175" FontSize="15" Click="BtnSwitchLang_Click" Focusable="False" Background="#34495E" Foreground="White" BorderThickness="0" Margin="2,1"/>
                    <Button x:Name="btnSpace" Grid.Column="1" Content="Space / مسافة" Style="{StaticResource KeypadButtonStyle}" FontSize="15" Click="BtnKeyboardSpace_Click" Focusable="False" Margin="5,1"/>
                    <Button x:Name="btnBackspace" Grid.Column="2" Content="⌫" Style="{StaticResource KeypadButtonStyle}" Width="105" FontSize="20" Click="BtnKeyboardBackspace_Click" Focusable="False" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="2,1"/>
                    <Button x:Name="btnToggleKeyboardSize" Grid.Column="3" Content="📐 كبير" Style="{StaticResource KeypadButtonStyle}" Width="95" FontSize="13.5" Click="BtnToggleKeyboardSize_Click" Focusable="False" Background="#2980B9" Foreground="White" BorderThickness="0" Margin="2,1" ToolTip="تبديل حجم لوحة المفاتيح"/>
                    <Button x:Name="btnHideKeyboard" Grid.Column="4" Content="❌" Style="{StaticResource KeypadButtonStyle}" Width="65" FontSize="16" Click="BtnHideKeyboard_Click" Focusable="False" Background="#7F8C8D" Foreground="White" BorderThickness="0" Margin="2,1"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

