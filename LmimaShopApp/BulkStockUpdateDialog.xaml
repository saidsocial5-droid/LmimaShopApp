<Window x:Class="LmimaShopApp.BulkStockUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل كمية المخزون لجميع المنتجات" Height="300" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft" WindowStyle="ToolWindow" Background="#F8F9FA"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- عنوان وإيقونة -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="42" Height="42" CornerRadius="8" Background="#FDEBD0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="تعديل كمية المخزون لجميع المنتجات" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="lblProductCount" Text="سيتم تطبيق التعديل على جميع المنتجات المسجلة" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- نص توضيحي -->
            <TextBlock Grid.Row="1" Text="حدد كمية المخزون الجديدة المراد تعيينها لكل المنتجات:" FontSize="13" Foreground="#34495E" Margin="0,4,0,8"/>

            <!-- حقل إدخال الكمية -->
            <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="1.5" CornerRadius="6" Padding="6" Margin="0,0,0,10">
                <TextBox x:Name="txtQuantity" Text="100" FontSize="22" FontWeight="Bold" Foreground="#D35400"
                         TextAlignment="Center" BorderThickness="0" Background="Transparent"
                         VerticalAlignment="Center"/>
            </Border>

            <!-- تنبيه تحذيري -->
            <TextBlock Grid.Row="3" Text="⚠️ تنبيه: سيتم تحديث رصيد المخزون لجميع السلع دفعة واحدة في قاعدة البيانات."
                       FontSize="11" Foreground="#E67E22" TextWrapping="Wrap" VerticalAlignment="Top"/>

            <!-- أزرار الإجراء -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                <Button Content="✅ تطبيق على الكل" Style="{StaticResource ActionButtonStyle}" Background="#D35400" Foreground="White"
                        Padding="18,7" Height="36" Margin="0,0,10,0"
                        IsDefault="True" Click="BtnApply_Click"/>
                <Button Content="إلغاء" Style="{StaticResource ActionButtonStyle}" Background="#E0E0E0" Foreground="#2C3E50"
                        Padding="18,7" Height="36"
                        IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
