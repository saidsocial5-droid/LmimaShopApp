<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LmimaShopApp.LoginWindow"
        Title="تسجيل الدخول - Lmima Shop" WindowState="Maximized" ResizeMode="CanMinimize" FlowDirection="RightToLeft"
        Icon="/Assets/app_icon.png"
        Background="Transparent" FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- ستايل حقل النص -->
        <Style x:Key="LoginTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="White" CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل حقل كلمة المرور -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="border" Background="White" CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. صورة الخلفية للمتجر مع تعتيم للمحافظة على المقروئية -->
        <Grid>
            <Image x:Name="imgBg" Source="Assets/store_bg.jpg" Stretch="UniformToFill"/>
            <Border Background="#99000000"/>
            <!-- تعتيم أسود بنسبة 60% -->
        </Grid>

        <!-- 2. بطاقة تسجيل الدخول (مع تأثير الظل وتصميم شبه شفاف) -->
        <Border Height="454" CornerRadius="12" VerticalAlignment="Center" Padding="25" HorizontalAlignment="Center" Width="406">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.95"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.45"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <!-- أيقونة المتجر -->
                <Image Source="/Assets/app_icon.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,15" Stretch="Uniform"/>

                <!-- عنوان الترحيب -->
                <TextBlock Text="مرحباً بك في لميمة شوب" FontSize="30" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20" Foreground="#1B365D" Height="50" Width="359"/>

                <!-- اسم المستخدم -->
                <TextBlock Text="اسم المستخدم:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#2C3E50"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource LoginTextBoxStyle}" Margin="0,0,0,12"/>

                <!-- كلمة المرور -->
                <TextBlock Text="كلمة المرور:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#2C3E50"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource LoginPasswordBoxStyle}" Margin="0,0,0,12"/>

                <!-- خيار تذكرني -->
                <CheckBox x:Name="chkRememberMe" Content="تذكرني" FontSize="13" Foreground="#2C3E50" FontWeight="SemiBold" VerticalContentAlignment="Center" Margin="2,0,0,20" FlowDirection="RightToLeft"/>

                <!-- زر الدخول -->
                <Button x:Name="btnLogin" Content="تسجيل الدخول" IsDefault="True" Height="38" FontSize="15" FontWeight="Bold" Background="#1B365D" Foreground="White" Click="BtnLogin_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2C5E8A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#122642"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>