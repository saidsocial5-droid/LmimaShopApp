<Window x:Class="LmimaShopApp.MobileScannerPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات وربط تطبيق الهاتف الذكي - LMIMA SHOP" Height="620" Width="680"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الهيدر -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="0,0,0,12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📱 ربط وإعدادات تطبيق الهاتف الذكي" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="امسح الرمز بكاميرا الهاتف أو أدخل العنوان ورمز الاقتران للربط المباشر اللحظي" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="borderServerBadge" Background="#DEF7EC" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="lblServerStatus" Text="🟢 الخادم يعمل بنشاط" FontSize="12" FontWeight="Bold" Foreground="#03543F"/>
                </Border>
            </Grid>
        </Border>

        <!-- المحتوى الرئيسي مقسم لعمودين: QR Code والمعلومات والتحكم -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- العمود الأيمن: رمز الاستجابة السريعة QR -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,15,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📷 امسح الرمز بالهاتف" FontSize="13" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                        <Image x:Name="imgQrCode" Width="200" Height="200" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="يفتح التطبيق ويقترن بالمتجر تلقائياً" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- العمود الأيسر: العناوين والأزرار -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5,0,0,0">
                    
                    <!-- بطاقة عنوان IP -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🌐 عنوان الخادم المحلي (IP &amp; Port):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtServerUrl" Grid.Column="0" IsReadOnly="True" FontSize="15" FontWeight="Bold" Foreground="#2563EB" Background="#EFF6FF" BorderThickness="0" Padding="8,6" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="📋 نسخ" Width="60" Margin="6,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCopyUrl_Click"/>
                            </Grid>
                            <ComboBox x:Name="cmbAlternativeIps" Height="30" FontSize="11" Margin="0,8,0,0" ToolTip="كروت الشبكة الأخرى المتاحة" SelectionChanged="CmbAlternativeIps_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- بطاقة كود الاقتران -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🔑 رمز الاقتران (Pairing Code):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtPairingCode" Grid.Column="0" Text="123456" FontSize="18" FontWeight="Bold" TextAlignment="Center" Foreground="#0D9488" Background="#F0FDFA" BorderBrush="#99F6E4" Padding="4"/>
                                <Button Grid.Column="1" Content="🎲 توليد جديد" Margin="6,0,0,0" Padding="10,0" Background="#0F766E" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnNewPairingCode_Click"/>
                                <Button Grid.Column="2" Content="💾 حفظ" Margin="6,0,0,0" Width="55" Background="#14B8A6" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSavePairingCode_Click"/>
                            </Grid>
                            <TextBlock Text="يمكنك إدخال هذا الرمز في تطبيق الهاتف لتأكيد صلاحية الربط" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- أزرار التحكم والربط والتحيين المباشر -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="⚡ إجراءات الربط والمزامنة السريعة:" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
                            
                            <Button x:Name="btnBroadcastSync" Content="🔄 تحيين وبث المزامنة لجميع الهواتف المتصلة الآن" Height="38" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,0,8" Click="BtnBroadcastSync_Click"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="♻️ إعادة تشغيل الخادم" Height="36" Background="#475569" Foreground="White" FontWeight="Bold" Margin="0,0,4,0" Cursor="Hand" Click="BtnRestartServer_Click"/>
                                <Button Grid.Column="1" Content="🛡️ فتح جدار الحماية" Height="36" Background="#EA580C" Foreground="White" FontWeight="Bold" Margin="4,0,0,0" Cursor="Hand" Click="BtnOpenFirewall_Click"/>
                            </Grid>

                            <Button Content="👥 إدارة الأجهزة المقترنة بالبرنامج" Height="34" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="BtnManageDevices_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- زر الإغلاق السفلي -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Padding="0,12,0,0" Margin="0,15,0,0">
            <Button Content="إغلاق النافذة ✕" Width="150" Height="38" Background="#64748B" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Cursor="Hand" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
