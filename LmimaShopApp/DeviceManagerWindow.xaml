<Window x:Class="LmimaShopApp.DeviceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الأجهزة والمزامنة" Height="450" Width="600" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="الأجهزة المقترنة" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <DataGrid x:Name="DevicesDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الجهاز" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="آخر ظهور" Binding="{Binding LastSeen}" Width="150"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                <DataGridTemplateColumn Header="إجراء">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="إلغاء الصلاحية (Revoke)" Click="RevokeDevice_Click" Tag="{Binding DeviceId}" Foreground="Red"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button Content="اقتران جهاز جديد (QR)" Margin="0,0,10,0" Padding="15,10" Background="#4CAF50" Foreground="White" Click="ShowPairingQR_Click"/>
            <Button Content="تحديث القائمة" Padding="15,10" Click="RefreshList_Click"/>
        </StackPanel>
    </Grid>
</Window>



