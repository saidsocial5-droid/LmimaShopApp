<UserControl x:Class="LmimaShopApp.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LmimaShopApp"
             mc:Ignorable="d"
             Height="780" Width="1350"
             FlowDirection="RightToLeft" Background="#F8F9FA" FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <!-- ستايل أزرار الكيبورد الرقمي -->
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2980B9"/>
            <Setter Property="BorderBrush" Value="#AED6F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D4E6F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل أزرار القائمة الجانبية (Sidebar) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="25,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل الزر النشط في القائمة الجانبية -->
        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل البطاقات المظللة الحديثة -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#EBEBEB"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="8" ShadowDepth="1" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار الواجهة العامة -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل أزرار التبويبات الفوقية (Horizontal Tabs) -->
        <Style x:Key="TopTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FAFAFA"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveTopTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TopTabButtonStyle}">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="White" CornerRadius="4" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ================= 1. محتوى شاشة إعدادات النظام ================= -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- هيدر العنوان -->
            <RowDefinition Height="Auto"/>
            <!-- التبويبات الفوقية -->
            <RowDefinition Height="Auto"/>
            <!-- كارت الإعدادات الرئيسي -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. هيدر العنوان -->
        <TextBlock Grid.Row="0" Text="إعدادات النظام" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="10,5,10,15"/>

        <!-- 2. التبويبات الفوقية (Horizontal Tabs) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,10">
            <Button x:Name="tabAbout" Content="عن البرنامج" Style="{StaticResource TopTabButtonStyle}" Margin="0,0,5,0" Click="Tab_Click"/>
            <Button x:Name="tabMobileSync" Content="ربط الهاتف والمزامنة" Style="{StaticResource TopTabButtonStyle}" Margin="0,0,5,0" Click="Tab_Click"/>
            <Button x:Name="tabBackup" Content="النسخ الاحتياطي" Style="{StaticResource TopTabButtonStyle}" Margin="0,0,5,0" Click="Tab_Click"/>
            <Button x:Name="tabBarcode" Content="طباعة الباركود" Style="{StaticResource TopTabButtonStyle}" Margin="0,0,5,0" Click="Tab_Click"/>
            <Button x:Name="tabInvoice" Content="طباعة الفواتير" Style="{StaticResource TopTabButtonStyle}" Margin="0,0,5,0" Click="Tab_Click"/>
            <Button x:Name="tabStore" Content="بيانات المتجر" Style="{StaticResource TopTabButtonStyle}" Margin="0,0,5,0" Click="Tab_Click"/>
            <Button x:Name="tabApp" Content="إعدادات البرنامج" Style="{StaticResource ActiveTopTabButtonStyle}" Click="Tab_Click"/>
        </StackPanel>

        <!-- 3. كارت الإعدادات الرئيسي -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="25" MaxWidth="700" HorizontalAlignment="Right" Width="680">
            <Grid>
                    <!-- 1. إعدادات البرنامج (التبويب الحالي) -->
                    <Grid x:Name="gridAppSettings" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                            <TextBlock Text="⚙️ إعدادات البرنامج" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- صيغة التاريخ والوقت -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="صيغة التاريخ:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbDateFormat" Height="34" FontSize="13" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="DD/MM/YYYY (مثال: 13/01/2026)" IsSelected="True"/>
                                        <ComboBoxItem Content="YYYY-MM-DD (مثال: 2026-01-13)"/>
                                        <ComboBoxItem Content="MM/DD/YYYY (مثال: 01/13/2026)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="صيغة الوقت:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbTimeFormat" Height="34" FontSize="13" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="24 ساعة (مثال: 14:30)" IsSelected="True"/>
                                        <ComboBoxItem Content="12 ساعة (مثال: 02:30 م)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- العملة والمنازل العشرية -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="رمز العملة:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbCurrency" Height="34" FontSize="13" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="درهم (درهم مغربي)" IsSelected="True"/>
                                        <ComboBoxItem Content="ج.م. (جنيه مصري)"/>
                                        <ComboBoxItem Content="د.إ. (درهم إماراتي)"/>
                                        <ComboBoxItem Content="$ (دولار أمريكي)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="المنازل العشرية:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbDecimals" Height="34" FontSize="13" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="منزلتين (مثال: 100.00)" IsSelected="True"/>
                                        <ComboBoxItem Content="منزلة واحدة (مثال: 100.0)"/>
                                        <ComboBoxItem Content="بلا منازل عشرية (مثال: 100)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- لغة البرنامج -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="لغة البرنامج:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbLanguage" Height="34" FontSize="13" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="العربية" IsSelected="True"/>
                                        <ComboBoxItem Content="English"/>
                                        <ComboBoxItem Content="Français"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- خط البرنامج -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="خط البرنامج (العربية):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbFontFamily" Height="34" FontSize="13" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Cairo (كايرو - عصري)" Tag="Cairo"/>
                                        <ComboBoxItem Content="Tajawal (تجوال - هندسي)" Tag="Tajawal"/>
                                        <ComboBoxItem Content="Amiri (أميري - كلاسيكي)" Tag="Amiri"/>
                                        <ComboBoxItem Content="Almarai (المراعي - ناعم)" Tag="Almarai"/>
                                        <ComboBoxItem Content="Segoe UI (خط النظام - ويندوز)" Tag="Segoe UI"/>
                                        <ComboBoxItem Content="Tahoma (تاهوما - كلاسيكي)" Tag="Tahoma"/>
                                        <ComboBoxItem Content="Arial (أريال)" Tag="Arial"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- خلفية شاشة تسجيل الدخول -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,15,0,0">
                                    <TextBlock Text="خلفية شاشة تسجيل الدخول:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- معاينة الخلفية المحددة -->
                                        <Border Grid.Column="0" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="6" Width="150" Height="80" HorizontalAlignment="Right" Margin="0,0,10,0" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock x:Name="txtNoLoginBgPlaceholder" Text="🖼️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDC3C7"/>
                                                <Image x:Name="imgLoginBgPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="lblLoginBgFileName" Text="لم يتم اختيار ملف (سيتم استخدام الخلفية الافتراضية)" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="اختيار صورة" Style="{StaticResource TopTabButtonStyle}" Click="BtnBrowseLoginBg_Click" Width="130" Height="30" Padding="5,0"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtLoginBgPath" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                            <Button Content="حفظ إعدادات البرنامج" Style="{StaticResource ModernButtonStyle}" Height="40" Click="BtnSaveSettings_Click"/>
                            <Button Content="🔄 تصحيح روابط صور المنتجات يدوياً" Style="{StaticResource ModernButtonStyle}" Height="40" Margin="0,10,0,0" Click="BtnHealImagePaths_Click" Background="#E67E22"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. بيانات المتجر -->
                    <Grid x:Name="gridStoreSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="🏪 بيانات المتجر" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,10">
                                <!-- شعار المتجر -->
                                <TextBlock Text="شعار المتجر:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="6" Width="100" Height="100" HorizontalAlignment="Right" Margin="0,0,10,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock x:Name="txtNoLogoPlaceholder" Text="🏪" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDC3C7"/>
                                            <Image x:Name="imgLogoPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="lblLogoFileName" Text="Aucun fichier choisi" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="Choisir un fichier" Style="{StaticResource TopTabButtonStyle}" Click="BtnBrowseLogo_Click" Width="130" Height="30" Padding="5,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtLogoPath" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- اسم المتجر -->
                                <TextBlock Text="اسم المتجر:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtStoreName" Text="متجر LMIMA SHOP" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <!-- رقم الهاتف -->
                                <TextBlock Text="رقم الهاتف:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtStorePhone" Text="0614714949" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <!-- العنوان -->
                                <TextBlock Text="العنوان:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtStoreAddress" Text="SIDI ASSOU" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <!-- تذييل الفاتورة -->
                                <TextBlock Text="تذييل الفاتورة:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtInvoiceFooter" Text="شكراً لزيارتكم" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <!-- البيانات الضريبية (Moroccan Fiscal Data) -->
                                <TextBlock Text="الرقم التعريفي الموحد (ICE):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtICE" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <TextBlock Text="التعريف الضريبي (IF):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtIF" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <TextBlock Text="السجل التجاري (RC):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtRC" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <TextBlock Text="الضريبة المهنية (Patente):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtPatente" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>

                                <TextBlock Text="القيمة المضافة الافتراضية (TVA %):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtDefaultTva" Text="20" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="حفظ بيانات المتجر" Style="{StaticResource ModernButtonStyle}" Background="#2980B9" Height="40" Margin="0,15,0,0" Click="BtnSaveStoreSettings_Click"/>
                    </Grid>

                    <!-- 3. طباعة الفواتير -->
                    <Grid x:Name="gridInvoiceSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="إعدادات طابعة الفواتير وصندوق النقود (درج الكاشير)" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <!-- طابعة الفواتير -->
                                <TextBlock Text="طابعة الفواتير الافتراضية:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbInvoicePrinters" Grid.Column="0" Height="34" FontSize="13" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔄" Width="34" Height="34" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="BtnRefreshPrinters_Click" ToolTip="تحديث قائمة الطابعات"/>
                                </Grid>

                                <!-- مقاس ورق الطباعة -->
                                <TextBlock Text="مقاس ورق الفاتورة:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <ComboBox x:Name="cmbPaperSize" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15">
                                    <ComboBoxItem Content="80 مم (عرض افتراضي)" Tag="80"/>
                                    <ComboBoxItem Content="57 مم (عرض ضيق)" Tag="57"/>
                                </ComboBox>

                                <!-- خيار فتح الصندوق تلقائيا -->
                                <CheckBox x:Name="chkOpenDrawerOnCheckout" Content="فتح درج النقود (صندوق الكاشير) تلقائياً عند إنهاء عملية البيع" 
                                          FontSize="13" Foreground="#2C3E50" Margin="0,10,0,20" FlowDirection="RightToLeft" HorizontalAlignment="Right"/>

                                <!-- خيار طباعة الشعار -->
                                <CheckBox x:Name="chkPrintStoreLogo" Content="طباعة شعار المتجر في أعلى الفاتورة" 
                                          FontSize="13" Foreground="#2C3E50" Margin="0,10,0,15" FlowDirection="RightToLeft" HorizontalAlignment="Right" Checked="ChkPrintStoreLogo_Checked" Unchecked="ChkPrintStoreLogo_Unchecked"/>

                                <!-- تحميل ومعاينة الشعار للفاتورة -->
                                <Grid x:Name="gridInvoiceLogoContainer" Margin="0,0,0,15" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="6" Width="90" Height="90" HorizontalAlignment="Right" Margin="0,0,10,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock x:Name="txtNoInvoiceLogoPlaceholder" Text="🖼️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDC3C7"/>
                                            <Image x:Name="imgInvoiceLogoPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="lblInvoiceLogoFileName" Text="لم يتم اختيار ملف" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="اختيار ملف" Style="{StaticResource TopTabButtonStyle}" Click="BtnBrowseInvoiceLogo_Click" Width="120" Height="30" Padding="5,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtInvoiceLogoPath" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- كود فتح الصندوق المخصص -->
                                <TextBlock Text="أمر فتح صندوق النقود (ESC/POS code) - اختياري:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                <TextBox x:Name="txtDrawerKickCode" Text="27,112,0,25,250" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextAlignment="Right" ToolTip="كود فتح الدرج الافتراضي للطابعات الحرارية"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="حفظ إعدادات الفاتورة والدرج" Style="{StaticResource ModernButtonStyle}" Background="#2980B9" Height="40" Margin="0,15,0,0" Click="BtnSaveInvoiceSettings_Click"/>
                    </Grid>

                    <!-- 4. طباعة الباركود -->
                    <Grid x:Name="gridBarcodeSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="🏷️ تصميم وطباعة ملصقات الباركود" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- العمود الأيسر: معاينة الملصق -->
                                <ColumnDefinition Width="220"/>
                                <!-- العمود الأوسط: الخيارات والإدخال -->
                                <ColumnDefinition Width="*"/>
                                <!-- العمود الأيمن: لوحة المفاتيح الرقمية -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- المعاينة -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Center">
                                <TextBlock Text="معاينة الملصق:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,10"/>
                                <Border x:Name="borderBarcodeLabelPreview" BorderBrush="#BDC3C7" BorderThickness="1" Background="White" CornerRadius="4" Width="180" Height="120" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock x:Name="lblPreviewStore" Text="LMIMA SHOP" FontSize="11" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center" Grid.Row="0"/>
                                        <TextBlock x:Name="lblPreviewName" Text="اسم المنتج التجريبي" FontSize="12" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,2" Grid.Row="1"/>
                                        
                                        <Border Grid.Row="2" Background="Transparent" VerticalAlignment="Center" Height="40" Margin="0,2">
                                            <Canvas x:Name="canvasBarcodeBars" Width="160" Height="40"/>
                                        </Border>
                                        
                                        <Grid Grid.Row="3" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblPreviewBarcode" Text="123456789012" FontSize="10" Foreground="DimGray" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblPreviewPrice" Text="0.00 درهم" FontSize="11" FontWeight="Bold" Foreground="#27AE60" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="ملاحظة: المعاينة تقريبية لملصق الباركود." FontSize="10" Foreground="#7F8C8D" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- الخيارات والإدخال -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- البحث واختيار المنتج -->
                                    <TextBlock Text="البحث عن منتج:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtBarcodeProductSearch" Grid.Column="0" Style="{StaticResource ModalTextBoxStyle}" TextAlignment="Right" TextChanged="TxtBarcodeProductSearch_TextChanged"/>
                                        <Button Content="⌨️" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Width="35" Height="34" Click="BtnToggleVirtualKeyboard_Click" Focusable="False" Margin="5,0,0,0" ToolTip="إظهار/إخفاء لوحة المفاتيح"/>
                                    </Grid>

                                    <TextBlock Text="اختر المنتج:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                    <ComboBox x:Name="cmbBarcodeProduct" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15" SelectionChanged="CmbBarcodeProduct_SelectionChanged"/>

                                    <!-- اسم المنتج والباركود والسعر المطبوع -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- الباركود -->
                                        <StackPanel Grid.Column="1" Margin="0,0,5,15">
                                            <TextBlock Text="رقم الباركود (قابل للتعديل):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                            <TextBox x:Name="txtBarcodeCode" Style="{StaticResource ModalTextBoxStyle}" TextChanged="BarcodeInputs_TextChanged"/>
                                        </StackPanel>

                                        <!-- السعر -->
                                        <StackPanel Grid.Column="0" Margin="5,0,0,15">
                                            <TextBlock Text="السعر المطبوع (درهم):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                            <TextBox x:Name="txtBarcodePrice" Style="{StaticResource ModalTextBoxStyle}" TextChanged="BarcodeInputs_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- اسم المنتج -->
                                    <TextBlock Text="اسم المنتج للملصق:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                    <TextBox x:Name="txtBarcodeProductName" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,15" TextChanged="BarcodeInputs_TextChanged"/>

                                    <!-- اسم المتجر وحجم الملصق -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- اسم المتجر -->
                                        <StackPanel Grid.Column="1" Margin="0,0,5,15">
                                            <TextBlock Text="اسم المتجر على الملصق:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                            <TextBox x:Name="txtBarcodeStoreName" Text="LMIMA SHOP" Style="{StaticResource ModalTextBoxStyle}" TextChanged="BarcodeInputs_TextChanged"/>
                                        </StackPanel>

                                        <!-- حجم الملصق -->
                                        <StackPanel Grid.Column="0" Margin="5,0,0,15">
                                            <TextBlock Text="حجم الملصق:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                            <ComboBox x:Name="cmbBarcodeSize" Height="34" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="CmbBarcodeSize_SelectionChanged">
                                                <ComboBoxItem Content="38 ملم × 25 ملم (افتراضي)" IsSelected="True" Tag="38x25"/>
                                                <ComboBoxItem Content="40 ملم × 30 ملم" Tag="40x30"/>
                                                <ComboBoxItem Content="50 ملم × 25 ملم" Tag="50x25"/>
                                                <ComboBoxItem Content="50 ملم × 30 ملم" Tag="50x30"/>
                                                <ComboBoxItem Content="58 ملم × 40 ملم" Tag="58x40"/>
                                                <ComboBoxItem Content="60 ملم × 40 ملم" Tag="60x40"/>
                                                <ComboBoxItem Content="80 ملم × 50 ملم" Tag="80x50"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- طابعة الملصقات -->
                                        <StackPanel Grid.Column="1" Margin="0,0,5,15">
                                            <TextBlock Text="طابعة الملصقات:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="cmbBarcodePrinter" Grid.Column="0" Height="34" FontSize="13" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="🔄" Width="34" Height="34" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="BtnRefreshPrinters_Click" ToolTip="تحديث قائمة الطابعات"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- عدد النسخ -->
                                        <StackPanel Grid.Column="0" Margin="5,0,0,15">
                                            <TextBlock Text="عدد النسخ المطبوعة:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5" TextAlignment="Right"/>
                                            <TextBox x:Name="txtBarcodeCopies" Text="1" Style="{StaticResource ModalTextBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- زر الطباعة -->
                                    <Button Content="🖨️ طباعة ملصقات الباركود" Style="{StaticResource ModernButtonStyle}" Background="#27AE60" Height="40" Margin="0,10,0,0" Click="BtnPrintBarcode_Click"/>
                                    
                                    <!-- زر التصدير كـ JPEG -->
                                    <Button Content="💾 تصدير الباركود كـ JPEG" Style="{StaticResource ModernButtonStyle}" Background="#2980B9" Height="40" Margin="0,10,0,0" Click="BtnExportBarcodeJpeg_Click"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- لوحة أرقام جانبية للأسعار والباركود -->
                            <Grid Grid.Column="2" Width="180" Height="220" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Content="C" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="⌫" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Background="#34495E" Foreground="White" BorderThickness="0" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="1" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="2" Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="3" Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="5" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="6" Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="7" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="8" Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="9" Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="," Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="0" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="BarcodeKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 5. النسخ الاحتياطي والاستعادة (Google Drive) -->
                    <Grid x:Name="gridBackupSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Padding="0,0,0,12" Margin="0,0,0,15">
                            <TextBlock Text="💾 النسخ الاحتياطي السحابي واستعادة البيانات (Google Drive)" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="850" HorizontalAlignment="Right" Margin="0,0,10,20">
                                
                                <!-- بطاقة النسخ الاحتياطي السحابي (Google Drive) -->
                                <Border BorderThickness="1" BorderBrush="#D1D5DB" CornerRadius="10" Padding="20" Background="White" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="☁️ النسخ الاحتياطي السحابي (Google Drive)" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8" TextAlignment="Right"/>

                                        <TextBlock Text="قم بربط البرنامج بمجلد Google Drive على حاسوبك (أو أي مجلد سحابي آخر مثل OneDrive). سيقوم البرنامج بحفظ النسخ تلقائياً فيه ليتم رفعها ومزامنتها مباشرة إلى السحابة، مما يحمي مبيعاتك وديون الزبائن من أي ضياع." 
                                                   FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,15" TextAlignment="Right" LineHeight="19"/>

                                        <!-- مسار مجلد النسخ الاحتياطي -->
                                        <TextBlock Text="مسار مجلد النسخ الاحتياطي (Google Drive):" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" TextAlignment="Right"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtBackupFolder" Grid.Column="0" IsReadOnly="False" Background="White" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,8" FontSize="12" 
                                                     VerticalContentAlignment="Center" Text="E:\Drive\Lmima Shop" TextChanged="TxtBackupFolder_TextChanged"/>
                                            
                                            <Button Grid.Column="1" Content="💾 حفظ المسار" Style="{StaticResource ModernButtonStyle}" 
                                                    Background="#059669" Height="36" Padding="12,0" Margin="6,0,0,0" Click="BtnSaveBackupFolder_Click" ToolTip="حفظ مسار مجلد النسخ الاحتياطي وتثبيته"/>

                                            <Button Grid.Column="2" Content="📁 استعراض..." Style="{StaticResource ModernButtonStyle}" 
                                                    Background="#2563EB" Height="36" Padding="12,0" Margin="6,0,0,0" Click="BtnBrowseBackupFolder_Click" ToolTip="اختر مجلد Google Drive"/>
                                            
                                            <Button Grid.Column="3" Content="🔍 كشف تلقائي" Style="{StaticResource ModernButtonStyle}" 
                                                    Background="#4F46E5" Height="36" Padding="10,0" Margin="6,0,0,0" Click="BtnDetectGoogleDrive_Click" ToolTip="البحث التلقائي عن Google Drive المثبت"/>

                                            <Button Grid.Column="4" Content="📂 فتح المجلد" Style="{StaticResource ModernButtonStyle}" 
                                                    Background="#6B7280" Height="36" Padding="10,0" Margin="6,0,0,0" Click="BtnOpenBackupFolder_Click" ToolTip="فتح المجلد في مستكشف ويندوز"/>
                                        </Grid>

                                        <!-- خيارات النسخ الاحتياطي والمزامنة التلقائية -->
                                        <Border Background="#F3F4F6" CornerRadius="8" Padding="14" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <StackPanel>
                                                <!-- الخيار 1: نسخ عند الإغلاق -->
                                                <CheckBox x:Name="chkAutoBackupOnExit" Content="🔄 إنشاء نسخة احتياطية تلقائياً عند إغلاق البرنامج وحفظها في Google Drive (موصى به)" 
                                                          FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" IsChecked="True" 
                                                          VerticalContentAlignment="Center" Margin="0,0,0,4" Checked="BackupOption_Changed" Unchecked="BackupOption_Changed"/>
                                                <TextBlock Text="عند تفعيل هذا الخيار، سيقوم البرنامج عند كل إغلاق بنسخ قاعدة البيانات بالكامل إلى المجلد المحدد ليقوم Google Drive بمزامنتها تلقائياً." 
                                                           FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="22,0,0,10" TextAlignment="Right"/>

                                                <!-- الخيار 2: نسخ ومزامنة دورية تلقائية أثناء العمل -->
                                                <Border BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="0,10,0,0" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox x:Name="chkPeriodicAutoBackup" Grid.Column="0" Content="⚡ تفعيل النسخ الاحتياطي السحابي والمزامنة التلقائية الدورية أثناء العمل" 
                                                                      FontSize="13" FontWeight="Bold" Foreground="#166534" IsChecked="True" 
                                                                      VerticalContentAlignment="Center" Checked="BackupOption_Changed" Unchecked="BackupOption_Changed"/>
                                                            
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="دورة المزامنة: " FontSize="12" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <ComboBox x:Name="cmbAutoBackupInterval" Width="145" Height="30" FontSize="12" SelectionChanged="CmbAutoBackupInterval_SelectionChanged">
                                                                    <ComboBoxItem Content="كل 15 دقيقة" Tag="15"/>
                                                                    <ComboBoxItem Content="كل 30 دقيقة (موصى به)" Tag="30" IsSelected="True"/>
                                                                    <ComboBoxItem Content="كل 1 ساعة" Tag="60"/>
                                                                    <ComboBoxItem Content="كل ساعتين" Tag="120"/>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="يقوم البرنامج تلقائياً بإنشاء نسخة احتياطية في مجلد Google Drive كل فترة محددة دون مقاطعة البيع، مما يضمن أمان بياناتك حتى في حال انقطاع الكهرباء المفاجئ." 
                                                                   FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="22,4,0,8" TextAlignment="Right"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- الخيار 3: مزامنة بيانات الهاتف السحابية -->
                                                <Border BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="0,8,0,0">
                                                    <StackPanel>
                                                        <CheckBox x:Name="chkAutoSyncMobileToCloud" Content="📲 مزامنة ورفع ملفات تطبيق الهاتف تلقائياً إلى مجلد Google Drive مع كل نسخة" 
                                                                  FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" IsChecked="True" 
                                                                  VerticalContentAlignment="Center" Margin="0,0,0,2" Checked="BackupOption_Changed" Unchecked="BackupOption_Changed"/>
                                                        <TextBlock Text="يتم حفظ ملف lmima_mobile_sync.json تلقائياً في مجلد السحابة لتتمكن من الوصول لبيانات المتجر من الهاتف حتى خارج المحل." 
                                                                   FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="22,0,0,0" TextAlignment="Right"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- بطاقة حالة النسخ والمزامنة التلقائية وأزرار التنفيذ -->
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock x:Name="lblAutoSyncStatusBadge" Text="🟢 المزامنة التلقائية نشطة" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                                    </Border>
                                                    <TextBlock x:Name="lblLastBackupStatus" Text="تاريخ آخر نسخة احتياطية: 2026-10-25 12:52:28" 
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="lblNextBackupStatus" Text="موعد النسخة التلقائية القادمة: بعد 28 دقيقة" 
                                                           FontSize="11" Foreground="#6B7280"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Content="💾 تصدير يدوي (USB / ملف)..." Style="{StaticResource ModernButtonStyle}" 
                                                        Background="#4B5563" Height="38" Padding="12,0" Margin="0,0,8,0" Click="BtnCreateBackup_Click"/>
                                                
                                                <Button Content="📲 مزامنة الهاتف الآن" Style="{StaticResource ModernButtonStyle}" 
                                                        Background="#0284C7" Height="38" Padding="12,0" FontWeight="Bold" Margin="0,0,8,0" Click="BtnSyncMobileNow_Click" ToolTip="تحديث بيانات المبيعات والديون فوراً لتطبيق الهاتف"/>

                                                <Button Content="🚀 أخذ نسخة سحابية الآن" Style="{StaticResource ModernButtonStyle}" 
                                                        Background="#16A34A" Height="38" Padding="16,0" FontWeight="Bold" Click="BtnCreateCloudBackup_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- بطاقة إعدادات ربط تطبيق الهاتف الذكي والمزامنة الفورية المدمجة -->
                                        <Border BorderThickness="1" BorderBrush="#BAE6FD" CornerRadius="10" Padding="16" Background="#F0F9FF" Margin="0,15,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📱 ربط تطبيق الهاتف والمزامنة المباشرة (Mobile Sync)" FontSize="13" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <Border x:Name="badgeMobileServerInBackup" Background="#DCFCE7" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock x:Name="lblMobileServerInBackup" Text="🟢 الخادم يعمل بنشاط (:8080)" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="lblMobileServerIpInBackup" Grid.Column="1" Text="العنوان: http://192.168.11.117:8080" FontSize="12" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                </Grid>

                                                <TextBlock Text="يمكن لهاتفك الاتصال مباشرة بالبرنامج عبر مسح الباركود، أو التحديث التلقائي، أو عبر مجلد Google Drive المشترك لمزامنة المبيعات والمنتجات والديون فورياً." 
                                                           FontSize="11" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="17"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="📱 فتح نافذة QR Code والربط" Style="{StaticResource ModernButtonStyle}" 
                                                                Background="#0284C7" Height="34" Padding="12,0" FontWeight="Bold" Margin="0,0,8,0" Click="BtnOpenMobileQrWindow_Click"/>
                                                        
                                                        <Button Content="⚡ بث تحيين لجميع الهواتف الآن" Style="{StaticResource ModernButtonStyle}" 
                                                                Background="#2563EB" Height="34" Padding="12,0" FontWeight="Bold" Margin="0,0,8,0" Click="BtnBroadcastSyncNow_Click"/>

                                                        <Button Content="🔄 إعادة تشغيل خادم الهاتف" Style="{StaticResource ModernButtonStyle}" 
                                                                Background="#475569" Height="34" Padding="10,0" Margin="0,0,8,0" Click="BtnRestartMobileServerQuick_Click"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="🛡️ فتح جدار الحماية (Firewall)" Style="{StaticResource ModernButtonStyle}" 
                                                            Background="#D97706" Height="34" Padding="12,0" FontWeight="Bold" Click="BtnOpenFirewallQuick_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة استعادة البيانات -->
                                <Border BorderThickness="1" BorderBrush="#FECACA" CornerRadius="10" Padding="20" Background="#FEF2F2" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ استعادة البيانات من نسخة سابقة (Restauration)" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,10" TextAlignment="Right"/>
                                        <TextBlock Text="تحذير هام: استعادة نسخة احتياطية سيؤدي إلى استبدال قاعدة البيانات الحالية بالبيانات الموجودة في ملف النسخة الاحتياطية المختار (.sql). تأكد من أخذ نسخة احتياطية حديثة قبل البدء." 
                                                   FontSize="12" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,0,0,15" TextAlignment="Right" LineHeight="18" FontWeight="Medium"/>
                                        <Button Content="🔄 استعادة قاعدة البيانات من ملف..." Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Height="40" HorizontalAlignment="Right" Width="240" Click="BtnRestoreBackup_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 7. إعدادات ربط تطبيق الهاتف والمزامنة -->
                    <Grid x:Name="gridMobileSyncSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Padding="0,0,0,12" Margin="0,0,0,15">
                            <TextBlock Text="📱 إعدادات ربط تطبيق الهاتف الذكي والمزامنة الفورية" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="850" HorizontalAlignment="Right" Margin="0,0,10,20">

                                <!-- بطاقة 1: خادم الاتصال المباشر بالهاتف -->
                                <Border BorderThickness="1" BorderBrush="#D1D5DB" CornerRadius="10" Padding="20" Background="White" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📡 خادم الاتصال المحلي المباشر (Wi-Fi)" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" x:Name="borderSettingsServerBadge" Background="#DEF7EC" CornerRadius="14" Padding="10,5">
                                                <TextBlock x:Name="lblSettingsServerStatus" Text="🟢 الخادم يعمل بنشاط على المنفذ 8080" FontSize="11" FontWeight="Bold" Foreground="#03543F"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="يتصل تطبيق الهاتف (LMIMA SHOP Mobile) بحاسوب الكاشير مباشرة عبر نفس شبكة Wi-Fi لنقل المبيعات، ومسح الباركود، وتحديث ديون الزبائن والأسعار فوراً دون الحاجة للإنترنت." 
                                                   FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="19"/>

                                        <TextBlock Text="عنوان الاتصال بالهاتف (IP Address):" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSettingsServerIp" Grid.Column="0" IsReadOnly="True" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="14" FontWeight="Bold" Foreground="#1D4ED8" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="1" Content="📋 نسخ العنوان" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="36" Padding="12,0" Margin="6,0,0,0" Click="BtnCopyServerIp_Click"/>
                                        </Grid>

                                        <TextBlock Text="كروت الشبكة المتاحة على هذا الحاسوب:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbSettingsNetworkIps" Height="32" FontSize="12" Margin="0,0,0,15" SelectionChanged="CmbSettingsNetworkIps_SelectionChanged"/>

                                        <!-- أزرار الإجراءات على الخادم -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="♻️ إعادة تشغيل خادم الاتصال" Style="{StaticResource ModernButtonStyle}" Background="#475569" Height="38" Margin="0,0,4,0" FontWeight="Bold" Click="BtnSettingsRestartServer_Click"/>
                                            <Button Grid.Column="1" Content="🛡️ فتح جدار الحماية (Firewall)" Style="{StaticResource ModernButtonStyle}" Background="#EA580C" Height="38" Margin="4,0,0,0" FontWeight="Bold" Click="BtnSettingsOpenFirewall_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة 2: إعدادات الاقتران والأمان -->
                                <Border BorderThickness="1" BorderBrush="#D1D5DB" CornerRadius="10" Padding="20" Background="White" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="🔑 إعدادات الاقتران والأمان (Device Pairing)" FontSize="15" FontWeight="Bold" Foreground="#0F766E" Margin="0,0,0,10"/>
                                        <TextBlock Text="يحمي رمز الاقتران برنامجك من اتصال أي أجهزة غير مصرح لها. عند فتح التطبيق لأول مرة على الهاتف، أدخل هذا الرمز لتأكيد صلاحية الهاتف." 
                                                   FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="19"/>

                                        <TextBlock Text="رمز الاقتران المعتمد (Pairing Code):" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSettingsPairingCode" Grid.Column="0" Text="123456" FontSize="18" FontWeight="Bold" TextAlignment="Center" Foreground="#0D9488" Background="#F0FDFA" BorderBrush="#99F6E4" Padding="6"/>
                                            <Button Grid.Column="1" Content="🎲 توليد كود جديد" Style="{StaticResource ModernButtonStyle}" Background="#0F766E" Height="38" Padding="12,0" Margin="6,0,0,0" Click="BtnSettingsNewPairingCode_Click"/>
                                            <Button Grid.Column="2" Content="💾 حفظ الكود" Style="{StaticResource ModernButtonStyle}" Background="#14B8A6" Height="38" Padding="12,0" Margin="6,0,0,0" Click="BtnSettingsSavePairingCode_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📱 إظهار كود QR للاقتران بالهاتف" Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="38" Margin="0,0,4,0" FontWeight="Bold" Click="BtnSettingsShowQr_Click"/>
                                            <Button Grid.Column="1" Content="👥 إدارة الأجهزة المقترنة بالبرنامج" Style="{StaticResource ModernButtonStyle}" Background="#334155" Height="38" Margin="4,0,0,0" FontWeight="Bold" Click="BtnManageDevices_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- بطاقة 3: أزرار التحيين والمزامنة الفورية -->
                                <Border BorderThickness="1" BorderBrush="#BAE6FD" CornerRadius="10" Padding="20" Background="#F0F9FF" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="⚡ أزرار التحيين والمزامنة الفورية" FontSize="15" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,8"/>
                                        <TextBlock Text="استخدم هذه الأزرار لبث أي تعديلات في الأسعار أو المنتجات أو الديون إلى جميع الهواتف المتصلة فورياً دون انتظار المزامنة الدورية." 
                                                   FontSize="12" Foreground="#0C4A6E" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="19"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔄 بث وتحديث فوري لجميع الهواتف المتصلة" Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="42" Margin="0,0,6,0" FontWeight="Bold" FontSize="12" Click="BtnSettingsBroadcastSync_Click"/>
                                            <Button Grid.Column="1" Content="💾 تحديث ملف المزامنة السحابية (Drive)" Style="{StaticResource ModernButtonStyle}" Background="#16A34A" Height="42" Margin="6,0,0,0" FontWeight="Bold" FontSize="12" Click="BtnSyncMobileNow_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 6. عن البرنامج -->
                    <Grid x:Name="gridAboutSettings" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="ℹ️ عن برنامج LMIMA SHOP" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                            <Border BorderThickness="1" BorderBrush="#E5E7EB" CornerRadius="8" Padding="20" Background="#F9FAFB">
                                <StackPanel>
                                    <TextBlock Text="LMIMA SHOP - نظام إدارة المبيعات والمخازن المتكامل" FontSize="14" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>
                                    <TextBlock Text="الإصدار: v2.0.0" FontSize="12" Foreground="#4B5563" Margin="0,0,0,5"/>
                                    <TextBlock Text="تاريخ التحديث: أغسطس 2026" FontSize="12" Foreground="#4B5563" Margin="0,0,0,5"/>
                                    <TextBlock Text="المطور: فريق تطوير Advanced Agentic Coding" FontSize="12" Foreground="#4B5563" Margin="0,0,0,15"/>
                                    <TextBlock Text="نظام نقاط بيع مبيعات سريع، إدارة المنتجات والفئات، إدارة الزبناء والديون، ونظام تقارير ورسومات تحليلية دقيقة." FontSize="13" Foreground="#4B5563" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
            </Grid>
            </Grid>
            </Border>
        </Grid>
</UserControl>


