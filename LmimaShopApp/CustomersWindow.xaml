<UserControl x:Class="LmimaShopApp.CustomersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LmimaShopApp"
             mc:Ignorable="d"
             Height="780" Width="1350"
             FlowDirection="RightToLeft" Background="#F8F9FA" FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <!-- ستايل البطاقات المظللة الحديثة -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#EBEBEB"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="8" ShadowDepth="1" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل أزرار الكيبورد الرقمي -->
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2980B9"/>
            <Setter Property="BorderBrush" Value="#AED6F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D4E6F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار الواجهة العامة -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار الألوان الخاصة -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2ECC71"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E74C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار العمليات داخل جدول البيانات -->
        <Style x:Key="GridNormalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GridNormalButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource GridNormalButtonStyle}">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D35400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل خانة الإدخال الفخمة للبحث -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="White" CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل خانة الإدخال المودرن للنوافذ المودال -->
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="White" CornerRadius="4" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل جدول البيانات -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F2F3F4"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9F9"/>
                        <Setter Property="Foreground" Value="#566573"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7E9"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= 2. محتوى شاشة إدارة الزبناء ================= -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- هيدر العنوان والبحث و الفلترة والزر -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- أزرار الإضافة والفلاتر -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- خانة البحث -->
                        <ColumnDefinition Width="*"/>
                        <!-- العنوان وأيقونة الزبناء -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- العنوان -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="إدارة الزبناء" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <TextBlock Text=" 👥" FontSize="20" Foreground="#2980B9" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- خانة البحث والباركود مع زر الكيبورد -->
                    <Grid Grid.Column="1" Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="txtSearch" Style="{StaticResource SearchTextBoxStyle}" Padding="10,5,35,5" 
                                     TextChanged="TxtSearch_TextChanged"
                                     Tag="بحث بالاسم أو الهاتف..."/>
                            <TextBlock Text="🔍" FontSize="14" Foreground="#BDC3C7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Content="⌨️" Style="{StaticResource ModernButtonStyle}" Background="White" Foreground="#566573" BorderBrush="#D5D8DC" BorderThickness="1" Width="38" Height="38" FontSize="16" Click="BtnToggleVirtualKeyboard_Click" Focusable="False" Margin="8,0,0,0" ToolTip="إظهار/إخفاء لوحة المفاتيح"/>
                    </Grid>

                    <!-- أزرار الإضافة والفلاتر -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbStatus" Width="100" Height="34" Margin="5,0" VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="الكل" IsSelected="True"/>
                            <ComboBoxItem Content="يسمح بالأجل"/>
                            <ComboBoxItem Content="لا يسمح بالأجل"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbBalance" Width="110" Height="34" Margin="5,0" VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="كل الأرصدة" IsSelected="True"/>
                            <ComboBoxItem Content="عليها ديون"/>
                            <ComboBoxItem Content="بلا ديون"/>
                        </ComboBox>
                        <Button Content="+ إضافة زبون" Style="{StaticResource SuccessButtonStyle}" Height="34" Padding="15,0" Click="BtnAddCustomer_Click"/>
                        <Button Content="📊 تحديث Sheet بـ Google Drive" Style="{StaticResource ModernButtonStyle}" Background="#1E8E3E" Height="34" Padding="12,0" Margin="5,0,0,0" Click="BtnSyncGoogleSheet_Click" ToolTip="تحديث ملف Google Sheets للزبناء والكريدي داخل مجلد Google Drive فوراً"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- جدول الزبناء -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <DataGrid x:Name="dgCustomers" ItemsSource="{Binding Customers}" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- الاسم -->
                        <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="15,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الهاتف -->
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="130"/>

                        <!-- حد الائتمان -->
                        <DataGridTextColumn Header="حد الائتمان" Binding="{Binding CreditLimit, StringFormat={}{0:N2}}" Width="110"/>

                        <!-- الرصيد المستحق -->
                        <DataGridTextColumn Header="الرصيد المستحق" Binding="{Binding DueBalance, StringFormat={}{0:N2}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- السماح بالأجل -->
                        <DataGridTemplateColumn Header="السماح بالأجل" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" Width="60">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllowCredit}" Value="True">
                                                        <Setter Property="Background" Value="#EBF5FB"/>
                                                        <Setter Property="BorderBrush" Value="#AED6F1"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AllowCredit}" Value="False">
                                                        <Setter Property="Background" Value="#F2F3F4"/>
                                                        <Setter Property="BorderBrush" Value="#D5D8DC"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AllowCredit}" Value="True">
                                                            <Setter Property="Text" Value="نعم"/>
                                                            <Setter Property="Foreground" Value="#2980B9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AllowCredit}" Value="False">
                                                            <Setter Property="Text" Value="لا"/>
                                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- أجل الكريدي -->
                        <DataGridTemplateColumn Header="أجل الكريدي" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllowCredit}" Value="False">
                                                        <Setter Property="Text" Value="-"/>
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding AllowCredit}" Value="True"/>
                                                            <Condition Binding="{Binding CreditPeriodType}" Value="Open"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="مفتوح"/>
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding AllowCredit}" Value="True"/>
                                                            <Condition Binding="{Binding CreditPeriodType}" Value="Limited"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="{Binding CreditPeriodDays, StringFormat={}محدد ({0} يوم)}"/>
                                                        <Setter Property="Foreground" Value="#2980B9"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- تاريخ الاستحقاق -->
                        <DataGridTemplateColumn Header="تاريخ الاستحقاق" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding CreditDueDate}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCreditOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="ToolTip" Value="تجاوز هذا الزبون تاريخ استحقاق الدفع!"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCreditOverdue}" Value="False">
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- عدد الفواتير -->
                        <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount}" Width="100"/>

                        <!-- إجراءات -->
                        <DataGridTemplateColumn Header="إجراءات" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- لا يمكن حذف الزبون النقدي الافتراضي (id = 1) -->
                                        <Button Content="🗑️" Width="32" Height="28" Margin="0,0,5,0" Click="BtnDeleteCustomer_Click" DataContext="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GridDangerButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Id}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="✏️" Style="{StaticResource GridWarningButtonStyle}" Width="32" Height="28" Margin="0,0,5,0" Click="BtnEditCustomer_Click" DataContext="{Binding}"/>
                                        <!-- زر تسديد الكريدي (يظهر فقط إذا كان للزبون ديون) -->
                                        <Button Content="💸" Click="BtnPayDebt_Click" DataContext="{Binding}" Width="32" Height="28" Margin="0,0,5,0" ToolTip="تسديد الكريدي">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GridNormalButtonStyle}">
                                                    <Setter Property="Background" Value="#27AE60"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DueBalance}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="📋" Style="{StaticResource GridNormalButtonStyle}" Width="32" Height="28" Click="BtnDetailsCustomer_Click" DataContext="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- المجموع العام للديون -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="15,10" Margin="10,0,10,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="المجموع العام لديون جميع الزبناء: " FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="lblTotalDebts" Text="0.00 درهم" FontSize="15" FontWeight="Bold" Foreground="#E67E22" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 3. النافذة المنبثقة لإضافة/تعديل زبون ================= -->
        <Grid x:Name="modalOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Width="660" MaxHeight="620" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- عنوان الشاشة مع زر الكيبورد -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⌨️" Width="40" Height="40" FontSize="18" Click="BtnToggleVirtualKeyboard_Click" Focusable="False" ToolTip="إظهار/إخفاء لوحة المفاتيح">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAECEE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#D5D8DC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock x:Name="lblModalTitle" Grid.Column="1" Text="إضافة زبون جديد" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Width="40"/>
                    </Grid>

                    <!-- محتوى النافذة الرئيسي -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- حقول الإدخال -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,15,0">
                                <!-- الاسم -->
                                <TextBlock Text="اسم الزبون:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustomerName" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,12"/>

                                <!-- الهاتف -->
                                <TextBlock Text="رقم الهاتف:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtPhone" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,12"/>

                                <!-- الرقم التعريفي للشركات (ICE) -->
                                <TextBlock Text="الرقم التعريفي (ICE) - اختياري للشركات:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustomerICE" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,12"/>

                                <!-- حد الائتمان -->
                                <TextBlock Text="حد الائتمان (درهم):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCreditLimit" Style="{StaticResource ModalTextBoxStyle}" Margin="0,0,0,12"/>

                                <!-- السماح بالأجل -->
                                <CheckBox x:Name="chkAllowCredit" Content="السماح بالبيع بالأجل" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" VerticalContentAlignment="Center" Margin="0,5,0,10" Checked="ChkAllowCredit_Changed" Unchecked="ChkAllowCredit_Changed"/>

                                <!-- تفاصيل الأجل (تظهر فقط عند تفعيل البيع بالأجل) -->
                                <StackPanel x:Name="panelCreditPeriod" Visibility="Collapsed" Margin="0,0,0,10">
                                    <TextBlock Text="نوع أجل الكريدي:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cmbCreditPeriodType" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectionChanged="CmbCreditPeriodType_SelectionChanged">
                                        <ComboBoxItem Content="أجل مفتوح (غير محدد بمدة)" Tag="Open" IsSelected="True"/>
                                        <ComboBoxItem Content="أجل محدد (بعدد أيام)" Tag="Limited"/>
                                    </ComboBox>

                                    <StackPanel x:Name="panelCreditDays" Visibility="Collapsed">
                                        <TextBlock Text="مدة الأجل (بالأيام):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                                        <TextBox x:Name="txtCreditPeriodDays" Style="{StaticResource ModalTextBoxStyle}" Text="30" Margin="0,0,0,12"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- لوحة أرقام جانبية للهاتف وحد الائتمان -->
                        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#E5E7EB" Padding="15,0,0,0" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Grid Width="180" Height="250">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Content="C" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="⌫" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Background="#34495E" Foreground="White" BorderThickness="0" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="1" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="2" Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="3" Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="5" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="6" Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="7" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="8" Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="9" Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                
                                <Button Content="." Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                                <Button Content="0" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="CustomerModalKeypad_Click" Margin="2" FontSize="14" FontWeight="Bold" Focusable="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- أزرار الحفظ والإلغاء -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="حفظ الزبون" Style="{StaticResource SuccessButtonStyle}" Width="140" Height="36" Click="BtnSaveCustomer_Click" Margin="0,0,10,0"/>
                        <Button Content="إلغاء" Style="{StaticResource DangerButtonStyle}" Background="#7F8C8D" Width="90" Height="36" Click="BtnCancelCustomer_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 4. النافذة المنبثقة لتسديد الديون ================= -->
        <Grid x:Name="debtOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Width="380" Height="Auto" Background="White" CornerRadius="8" Padding="20,15" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- عنوان الشاشة مع زر الكيبورد -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⌨️" Width="36" Height="36" FontSize="16" Click="BtnToggleVirtualKeyboard_Click" Focusable="False" ToolTip="إظهار/إخفاء لوحة المفاتيح">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAECEE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#D5D8DC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Grid.Column="1" Text="تسديد ديون الزبون" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Width="36"/>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="lblDebtInfo" Text="دينه الحالي: 0.00 درهم" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8" HorizontalAlignment="Center" TextAlignment="Center"/>
                        
                        <TextBlock Text="المبلغ المراد تسديده (درهم):" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAmountToPay" Style="{StaticResource ModalTextBoxStyle}" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" Margin="0,0,0,8"/>

                        <!-- اللوحة الرقمية -->
                        <Grid Height="210" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="C" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="⌫" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Background="#34495E" Foreground="White" BorderThickness="0" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>

                            <Button Content="1" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="2" Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="3" Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>

                            <Button Content="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="5" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="6" Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>

                            <Button Content="7" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="8" Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="9" Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>

                            <Button Content="." Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                            <Button Content="0" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KeypadButtonStyle}" Click="DebtKeypad_Click" Margin="2" FontSize="16" FontWeight="Bold" Focusable="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- أزرار الدفع والإلغاء -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Button Content="تأكيد التسديد" Style="{StaticResource SuccessButtonStyle}" Width="140" Height="38" Click="BtnConfirmPayDebt_Click" Margin="0,0,10,0"/>
                        <Button Content="إلغاء" Style="{StaticResource DangerButtonStyle}" Background="#7F8C8D" Width="90" Height="38" Click="BtnCancelPayDebt_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 5. النافذة المنبثقة لتفاصيل المشتريات وكشف الحساب ================= -->
        <Grid x:Name="detailsOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Margin="15" Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- العنوان وأزرار الإجراءات (طباعة، تصدير، واتساب) -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="lblDetailsTitle" Text="قائمة المشتريات وكشف حساب الزبون: " FontSize="17" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblDetailsPhone" Text="" FontSize="13" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="btnPrintStatement" Content="🖨️ طبع الفاتورة" Click="BtnPrintStatement_Click" Style="{StaticResource ModernButtonStyle}" Background="#1E293B" Height="32" Padding="12,4" Margin="0,0,8,0"/>
                                <Button x:Name="btnExportStatement" Content="📥 تصدير الفاتورة (HTML)" Click="BtnExportStatement_Click" Style="{StaticResource ModernButtonStyle}" Background="#0284C7" Height="32" Padding="12,4" Margin="0,0,8,0"/>
                                <Button x:Name="btnWhatsAppStatement" Content="💬 إرسال بالواتساب" Click="BtnWhatsAppStatement_Click" Style="{StaticResource ModernButtonStyle}" Background="#16A34A" Height="32" Padding="12,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- شريط فلترة التواريخ والمدد الزمنية -->
                        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️ الفترة الزمنية: " FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="btnFilterAll" Content="الكل (منذ البداية)" Click="BtnFilterAll_Click" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Height="28" Padding="10,2" Margin="0,0,5,0"/>
                                    <Button x:Name="btnFilterToday" Content="اليوم" Click="BtnFilterToday_Click" Style="{StaticResource ModernButtonStyle}" Background="#64748B" Height="28" Padding="10,2" Margin="0,0,5,0"/>
                                    <Button x:Name="btnFilterWeek" Content="آخر 7 أيام" Click="BtnFilterWeek_Click" Style="{StaticResource ModernButtonStyle}" Background="#64748B" Height="28" Padding="10,2" Margin="0,0,5,0"/>
                                    <Button x:Name="btnFilterMonth" Content="هذا الشهر (30 يوم)" Click="BtnFilterMonth_Click" Style="{StaticResource ModernButtonStyle}" Background="#64748B" Height="28" Padding="10,2" Margin="0,0,15,0"/>

                                    <TextBlock Text="من:" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="dpDetailsFrom" Width="130" Height="28" Margin="0,0,8,0"/>
                                    <TextBlock Text="إلى:" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="dpDetailsTo" Width="130" Height="28" Margin="0,0,8,0"/>
                                    <Button x:Name="btnApplyDetailsFilter" Content="🔍 تطبيق الفلترة" Click="BtnApplyDetailsFilter_Click" Style="{StaticResource ModernButtonStyle}" Background="#0D9488" Height="28" Padding="10,2"/>
                                </StackPanel>

                                <!-- تبديل العرض بين المشتريات والمدفوعات -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <RadioButton x:Name="rbShowPurchases" Content="🛒 المشتريات" IsChecked="True" Checked="RbShowPurchases_Checked" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="rbShowPayments" Content="💵 المبالغ المسددة (المدفوعات)" Checked="RbShowPayments_Checked" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- جدول 1: مشتريات الزبون -->
                    <DataGrid Grid.Row="1" x:Name="dgPurchases" Style="{StaticResource ModernDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="الكمية" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-" Click="BtnDecreaseQty_Click" DataContext="{Binding}" Width="24" Height="24" Margin="2,0" Style="{StaticResource GridNormalButtonStyle}"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="40" TextAlignment="Center" FontSize="13" FontWeight="Bold"/>
                                            <Button Content="+" Click="BtnIncreaseQty_Click" DataContext="{Binding}" Width="24" Height="24" Margin="2,0" Style="{StaticResource GridNormalButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الثمن المفرد" Binding="{Binding SellPrice, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="المجموع" Binding="{Binding SubTotal, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="تاريخ الشراء" Binding="{Binding PurchaseDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                            <DataGridTemplateColumn Header="إجراءات" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="💸 أداء" Click="BtnPayProduct_Click" DataContext="{Binding}" Padding="8,2" Height="26" Margin="0,0,5,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GridNormalButtonStyle}">
                                                        <Setter Property="Background" Value="#27AE60"/>
                                                        <Setter Property="BorderBrush" Value="#27AE60"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="↩️ إرجاع" Style="{StaticResource GridDangerButtonStyle}" Click="BtnReturnProduct_Click" DataContext="{Binding}" Padding="8,2" Height="26"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- جدول 2: المبالغ التي دفعها الزبون (التسديدات) -->
                    <DataGrid Grid.Row="1" x:Name="dgCustomerPayments" Style="{StaticResource ModernDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الوصل" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="تاريخ الدفع" Binding="{Binding PaymentDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/>
                            <DataGridTextColumn Header="البيان / طريقة الأداء" Binding="{Binding Note}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المسؤول / الكاشير" Binding="{Binding CashierName}" Width="150"/>
                            <DataGridTextColumn Header="المبلغ المسدد (د.م.)" Binding="{Binding Amount, StringFormat={}{0:N2} د.م.}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Button Content="إغلاق" Style="{StaticResource DangerButtonStyle}" Background="#7F8C8D" Width="90" Height="36" Click="BtnCloseDetails_Click" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- مجموع المسدد -->
                            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="مجموع المبالغ المسددة: " FontSize="13" FontWeight="Bold" Foreground="#047857"/>
                                    <TextBlock x:Name="lblPaymentsTotal" Text="0.00 درهم" FontSize="14" FontWeight="Bold" Foreground="#059669" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- مجموع المشتريات الإجمالي -->
                            <Border Background="#EAFAF1" BorderBrush="#27AE60" BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="مجموع المشتريات في الفترة: " FontSize="13" FontWeight="Bold" Foreground="#1E8449"/>
                                    <TextBlock x:Name="lblGrandTotal" Text="0.00 درهم" FontSize="14" FontWeight="Bold" Foreground="#27AE60" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- مجموع الكريدي فقط الصافي -->
                            <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="12,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="صافي الكريدي المتبقي: " FontSize="13" FontWeight="Bold" Foreground="#C0392B"/>
                                    <TextBlock x:Name="lblCreditTotal" Text="0.00 درهم" FontSize="15" FontWeight="Bold" Foreground="#E74C3C" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
